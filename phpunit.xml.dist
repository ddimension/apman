<?xml version="1.0" encoding="UTF-8"?>

<!-- https://docs.phpunit.de/en/9.6/configuration.html — the version
     symfony/phpunit-bridge resolves for this project -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheResultFile="var/cache/.phpunit.result.cache"
>
    <php>
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
    </php>

    <testsuites>
        <!--
            Unit only, and on purpose. Everything here runs without a database,
            without a broker and without an access point: the pieces that decide
            what a configuration ends up looking like are worth pinning down
            where they can be pinned down, and a suite that needs the fleet to
            be reachable is a suite nobody runs.
        -->
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </coverage>
</phpunit>
