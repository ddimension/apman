<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{% block title %}AP Manager{% endblock %} </title>

        {# vendored instead of unpkg: an admin tool for our own infrastructure
           must not depend on a cdn being reachable #}
        <script src="{{ asset('vendor/gridjs.umd.js') }}"></script>
        <link rel="stylesheet" type="text/css" href="{{ asset('vendor/gridjs-mermaid.min.css') }}" />
        {# Two links that answered 404 on every page for as long as they have
           been here. bundles/apman/css/custom.css never existed — the file
           lives at assets/css/custom.css and holds an abandoned dark mode that
           paints the body black with !important; pointing at it would make
           every light pill and card unreadable, so it stays unused until dark
           mode is done properly. The favicon is inline instead of a file, so
           there is nothing left to miss. #}
        <link rel="icon" href="data:image/svg+xml,{{ '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\"><rect width=\"16\" height=\"16\" rx=\"3\" fill=\"%2323303f\"/><path d=\"M4 10a5 5 0 0 1 8 0\" stroke=\"%234a8\" stroke-width=\"1.4\" fill=\"none\"/><path d=\"M6 12a2.6 2.6 0 0 1 4 0\" stroke=\"%234a8\" stroke-width=\"1.4\" fill=\"none\"/><circle cx=\"8\" cy=\"13.6\" r=\"1\" fill=\"%234a8\"/></svg>'|url_encode }}" />

        <style>
            body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; margin: 0; }
            nav.top { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem;
                      background: #23303f; padding: .4rem .75rem; }
            nav.top a { color: #dfe6ee; text-decoration: none; padding: .3rem .6rem;
                        border-radius: 3px; font-size: .95rem; }
            nav.top a:hover { background: #35455a; }
            nav.top a.active { background: #43587a; color: #fff; }
            nav.top .brand { color: #fff; font-weight: 600; margin-right: .75rem; }
            nav.top .spacer { flex: 1; }
            main { padding: .75rem; }
            table.aps { border-collapse: collapse; width: 100%; }
            table.aps th, table.aps td { border: 1px solid #ccc; padding: 2px 6px; vertical-align: top; }
            .small { font-size: 85%; color: #444; }
            .warn { color: #b00; }
            .ok { color: #070; }
            .stale { color: #999; font-style: italic; }
            .pill { padding: 0 .4rem; border-radius: 3px; font-size: 85%; }
            .pill.up { background: #dfd; color: #060; }
            .pill.down { background: #fdd; color: #900; }
            .bar { display: inline-block; height: .6rem; background: #ddd; width: 60px;
                   vertical-align: middle; border-radius: 2px; overflow: hidden; }
            .bar > span { display: block; height: 100%; background: #4a8; }
            .bar.weak > span { background: #d84; }
            .bar.bad > span { background: #c33; }
            /* ---- narrow screens ------------------------------------------
               The rule that used to live here stacked every table into blocks
               and hid the header row with it, so a phone showed a column of
               values with nothing to say what any of them meant — on /oldStatus
               that is 23 unlabelled values per station. Tables scroll sideways
               inside themselves instead: the header stays above its own column,
               and the page itself never scrolls sideways. */
            @media (max-width: 760px) {
                html, body { overflow-x: hidden; }
                main { padding: .5rem; }

                /* one swipeable row instead of three wrapped ones, so the
                   content still starts near the top of the screen */
                nav.top { flex-wrap: nowrap; overflow-x: auto; gap: .1rem;
                          padding: .25rem .5rem; scrollbar-width: none; }
                nav.top::-webkit-scrollbar { display: none; }
                nav.top a { flex: 0 0 auto; padding: .55rem .7rem; font-size: .95rem; }
                nav.top .brand { flex: 0 0 auto; }
                nav.top .spacer { display: none; }

                table.aps { display: block; overflow-x: auto;
                            max-width: 100%; -webkit-overflow-scrolling: touch; }
                table.aps th, table.aps td { white-space: nowrap; }

                /* the option editor is the exception: three columns, and the
                   middle one holds the controls you came to type in. Stacked it
                   reads and edits far better than it scrolls — with the column
                   name carried along, which is what the old rule threw away. */
                table.opts, table.opts tbody, table.opts tr, table.opts td { display: block; width: auto; }
                table.opts thead, table.opts tr.head { display: none; }
                table.opts tr { border: 1px solid #e3e3e8; border-radius: 4px;
                                margin-bottom: .5rem; padding: .4rem .5rem; }
                table.opts td { border: none; padding: .15rem 0; }
                table.opts td[data-label]::before {
                    content: attr(data-label) " ";
                    display: block; font-size: .72rem; text-transform: uppercase;
                    letter-spacing: .04em; color: #888;
                }
                table.opts td input[type="text"], table.opts td input[type="number"],
                table.opts td select, table.opts td textarea { width: 100%; box-sizing: border-box; }

                /* a channel list or a hostname has no spaces in it and is
                   happily 50 characters long, which is wider than the screen —
                   in a stacked cell that is what pushes the page sideways */
                table.opts td, .card, main p { overflow-wrap: anywhere; }
                table.opts code { white-space: normal; }

                /* Safari zooms the whole page when a control smaller than 16px
                   takes focus, which throws the layout off centre for the rest
                   of the visit */
                input, select, textarea, button { font-size: 16px; }
                button { padding: .45rem .7rem; }

                .toolbar, .gridbar { gap: .4rem; }
            }
        </style>
        {% block stylesheets %}{% endblock %}
        {% block header %}{% endblock %}
    </head>
    <body>
        {# the current route decides which entry is marked, so the bar says
           where you are instead of only where you can go #}
        {% set here = app.request is defined and app.request ? app.request.attributes.get('_route') : null %}
        <nav class="top" aria-label="Main">
            <span class="brand">AP Manager</span>
            <a href="{{ path('apman_default_index') }}" class="{{ here == 'apman_default_index' ? 'active' }}">Clients</a>
            <a href="{{ path('aps') }}" class="{{ here == 'aps' ? 'active' }}">Access Points</a>
            <a href="{{ path('ssids') }}" class="{{ here in ['ssids', 'ssid_detail'] ? 'active' }}">Networks</a>
            <a href="{{ path('apman_default_indexold') }}" class="{{ here == 'apman_default_indexold' ? 'active' }}">Details</a>
            <a href="{{ path('ppsk') }}" class="{{ here == 'ppsk' ? 'active' }}">PPSK</a>
            <a href="{{ path('ipsk') }}" class="{{ here == 'ipsk' ? 'active' }}">iPSK</a>
            <a href="{{ path('radius') }}" class="{{ here == 'radius' ? 'active' }}">RADIUS</a>
            <a href="{{ path('consistency') }}" class="{{ here == 'consistency' ? 'active' }}">Consistency</a>
            <a href="{{ path('admin_apman_accesspoint_list') }}">Admin</a>
            <span class="spacer"></span>
            {% block navextra %}{% endblock %}
        </nav>
        <main>
        {% block body %}{% endblock %}
        </main>
        {% block javascripts %}{% endblock %}
    </body>
</html>
