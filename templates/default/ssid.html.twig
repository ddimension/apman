{% extends 'frontend.html.twig' %}
{% block title %}{{ ssid.name }}{% endblock %}

{% block body %}
<h2>{{ ssid.name }} <span class="small">network configuration</span></h2>

<p class="small">
	These options are written into the <i>wifi-iface</i> section of every access point that
	carries this network. Only what you set is stored; everything else follows the OpenWrt
	default shown next to it. The descriptions come from OpenWrt's own schema, so they say
	what the option really does rather than what we remember it doing. Where the schema says
	nothing — which it does for a good sixty options — the text is ours and marked
	<span class="src">our note</span>.
</p>

{% if hints %}
	<div class="card warnbox">
		<b>Worth a look</b>
		<ul class="small">{% for h in hints %}<li>{{ h }}</li>{% endfor %}</ul>
	</div>
{% endif %}

<div class="card">
	<p class="small">
		<b>Carried by</b>
		{% if devices|length %}
			{{ devices|length }} bss —
			{% for d in devices|slice(0, 8) %}
				<a href="{{ path('ap_detail', {'name': d.ap}) }}">{{ d.ap }}</a><span class="stale">/{{ d.ifname ?: d.name }}{% if d.band %} {{ d.band }}{% endif %}</span>{{ not loop.last ? ', ' }}
			{% endfor %}
			{% if devices|length > 8 %} and {{ devices|length - 8 }} more{% endif %}
		{% else %}
			<span class="stale">no access point — this network exists only on paper</span>
		{% endif %}
		{% if keys|length %}
			<br><b>Per device keys</b> {{ keys|length }} —
			<a href="{{ path('ipsk') }}">iPSK</a>, <a href="{{ path('ppsk') }}">PPSK</a>
		{% endif %}
	</p>
</div>

{% if devices|length %}
	{% set trouble = devices|filter(d => d.trouble)|length %}
	<h3{{ trouble ? ' class="warn"' : '' }}>
		Where it runs
		<span class="small">
			{% for name, n in bssStates %}{{ n }}× {{ name }}{% if not loop.last %}, {% endif %}{% endfor %}
		</span>
	</h3>
	{% if trouble %}
		<p class="small warn">
			{{ trouble }} of {{ devices|length }} bss are not there. A network that is absent on one
			access point while its neighbours serve it looks like a client problem from every other
			page — this is the one that says otherwise.
		</p>
	{% endif %}
	<table class="aps">
		<tr><th>Access point</th><th>Interface</th><th>Band</th><th>State</th><th>Last heard</th></tr>
		{% for d in devices %}
			<tr>
				<td><a href="{{ path('ap_detail', {'name': d.ap}) }}">{{ d.ap ?: '—' }}</a></td>
				<td class="small"><code>{{ d.ifname ?: d.name }}</code></td>
				<td class="small">{{ d.band ?: '—' }}</td>
				<td class="small {{ d.trouble ? 'warn' : (d.state == 'DISABLED' ? 'stale' : 'ok') }}">
					{{ d.state }}
					{% if d.since %}<div class="stale">since {{ d.since|date('d.m. H:i') }}</div>{% endif %}
				</td>
				<td class="small {{ d.fresh ? '' : 'stale' }}">
					{% if d.seen %}{{ d.seen|date('d.m. H:i') }}{% if not d.fresh %} (stale){% endif %}
					{% else %}never{% endif %}
				</td>
			</tr>
		{% endfor %}
	</table>
{% endif %}

<form id="editor" method="post" action="{{ path('ssid_save', {'id': ssid.id}) }}">
	<div class="card radius">
		<b>RADIUS</b>
		<input type="hidden" name="radius_fallback_present" value="1">
		<p class="small">
			{% if radius.server %}
				{% if radius.onap %}
					Every access point answers this network itself, from the key set the controller
					ships to it — no <i>wpa_psk_file</i>, no <i>sae_password_file</i>, and a key is
					live at the station's next association, for WPA2 and WPA3/SAE alike.
				{% else %}
					The access points ask <code>{{ radius.server }}</code> before they let a station in.
				{% endif %}
				{% if radius.onap %}<span class="pill up" title="the access points answer per-station keys from their own key store; no psk file is involved">iPSK — answered by the AP itself</span>{% if not radius.auto %} <span class="pill">automatic per device keys are off</span>{% endif %}
				{% elseif radius.ppsk %}<span class="pill up">per device keys over RADIUS</span>
				{% else %}
					<span class="pill down">option <code>ppsk</code> is off</span> — without it OpenWrt writes no
					<code>wpa_psk_radius</code>, so the answer is only used as an access list, not as a key.
				{% endif %}
			{% else %}
				No <code>auth_server</code> is set, so the access points decide on their own.
				{% if radius.sae %}
					<span class="warn">With SAE that means no per device keys at all:</span> hostapd reads
					<i>sae_password_file</i> only when it reads its whole configuration, and never
					<i>wpa_psk_file</i>. Point this network at the controller and a key per device works here too.
				{% endif %}
			{% endif %}
		</p>
		<label class="small">
			<input type="checkbox" name="radius_fallback" value="1" {{ radius.fallback ? 'checked' }}>
			A device without a key of its own gets the network passphrase
			<span class="stale">— off means it is turned away, which closes the network to anything not listed</span>
		</label>
		<input type="hidden" name="auto_ppsk_present" value="1">
		<label class="small">
			<input type="checkbox" name="auto_ppsk" value="1" {{ radius.auto ? 'checked' }}>
			Turn shared use into per device keys by itself
			<span class="stale">— a station that comes in on a key bound to no address gets a copy
			bound to its own, same passphrase, so it becomes an identity without noticing. And
			handing out a key becomes an enrolment: the shared keys step aside until the new
			device has claimed it.</span>
		</label>
		<input type="hidden" name="moving_psk_present" value="1">
		<label class="small">
			<input type="checkbox" name="moving_psk" value="1" {{ radius.moving ? 'checked' }}>
			Let each enrolment replace the shared key
			<span class="stale">— the key issued for an enrolment stays as the network passphrase
			until the next one replaces it. Every device that used the old one already holds a copy
			of its own, so nothing is locked out; the shared secret simply moves on and was never
			handed to anybody but the last device enrolled.
			{% if radius.server and radius.ppsk %}Here that takes effect immediately — the access
			points ask us for every station and never held the passphrase themselves.
			{% else %}Careful: this network has no RADIUS behind it, so a new passphrase only
			reaches the access points at the next provisioning run.{% endif %}</span>
		</label>
		{% if radius.auto and radius.shared is defined and radius.shared == 0 %}
			<p class="small warn">
				No key bound to all addresses is in service here, so there is nothing to learn
				from — until one is issued, this switch does nothing.
			</p>
		{% endif %}
		{% if radius.counts|length %}
			<p class="small">
				Last 24 hours:
				{% for c in radius.counts %}
					{{ c.n }}&times;
					{% if c.result == 'accept' %}<span class="pill up">own key</span>
					{% elseif c.result == 'fallback' %}<span class="pill">network passphrase</span>
					{% else %}<span class="pill down">turned away</span>{% endif %}
				{% endfor %}
				<a href="{{ path('radius', {'ssid': radius.broadcast}) }}">show requests</a>
			</p>
		{% endif %}
	</div>

	<div class="toolbar">
		<input type="search" id="filter" placeholder="filter by name or description…">
		<label class="small">show
			<select id="scope">
				<option value="all">everything, including inactive functions</option>
				<option value="documented">set and documented defaults</option>
				<option value="set">only what is set</option>
			</select>
		</label>
		<button type="button" id="toggleall" class="ghost small">close all</button>
		<span id="shown" class="small stale"></span>
		<span class="spacer"></span>
		<button type="submit">Save</button>
		<span id="result" class="small"></span>
	</div>

	<p class="small legend">
		<span class="tag set">set</span> stored here and written to the access point ·
		<span class="tag def">default</span> not stored, the shown OpenWrt default applies ·
		<span class="tag off">off</span> a switch or list that is never written, so the function is off ·
		<span class="tag un">not written</span> hostapd's built-in default applies, which the schema does not state ·
		<span class="src">our note</span> description written by us because OpenWrt's schema has none
	</p>

	{% if features.maps|length %}
		<details class="group features" {{ features.overridden|length ? 'open' }}>
			<summary>
				<b>Features</b>
				<span class="small">what runs over this configuration on the way to an access point</span>
				<span class="pill {{ features.overridden|length ? 'down' : 'up' }}">{{ features.overridden|length }} overridden</span>
				<span class="pill">{{ features.maps|length }} mapped</span>
			</summary>

			<p class="small stale">
				Read only. Every enabled mapping runs its implementation over the options below,
				in order of priority, and may add, change or remove keys. Edit the mapping under
				Admin; here it only says what it does.
			</p>

			<table class="opts">
				<tr class="head">
					<th scope="col">Mapping</th>
					<th scope="col">Feature</th>
					<th scope="col">Priority</th>
					<th scope="col">Effect on the configuration</th>
				</tr>
				{% for m in features.maps %}
					<tr class="opt {{ m.enabled ? '' : 'state-off' }}">
						<td class="name" data-label="Mapping">
							<code>{{ m.name }}</code>
							{% if m.enabled %}<span class="tag set">enabled</span>
							{% else %}<span class="tag off">disabled</span>{% endif %}
						</td>
						<td class="val small" data-label="Feature">
							{{ m.feature }}
							{% if m.implementation %}<div class="stale"><code>{{ m.implementation }}</code></div>{% endif %}
						</td>
						<td class="small" data-label="Priority">{{ m.priority }}</td>
						<td class="doc small" data-label="Effect">
							{% if m.error %}
								<span class="warn">cannot be previewed: {{ m.error }}</span>
							{% elseif not m.enabled %}
								<span class="stale">switched off, so it changes nothing</span>
							{% elseif m.changes|length == 0 %}
								<span class="stale">changes nothing for this network</span>
							{% else %}
								{% for c in m.changes %}
									<div>
										<code>{{ c.key }}</code>
										{% if c.kind == 'added' %}
											<span class="tag set">adds</span>
											<code>{{ c.to is iterable ? c.to|join(', ') : c.to }}</code>
										{% elseif c.kind == 'removed' %}
											<span class="tag off">removes</span>
											<span class="stale">was <code>{{ c.from is iterable ? c.from|join(', ') : c.from }}</code></span>
										{% else %}
											<span class="tag def">changes</span>
											<span class="stale"><code>{{ c.from is iterable ? c.from|join(', ') : c.from }}</code> →</span>
											<code>{{ c.to is iterable ? c.to|join(', ') : c.to }}</code>
										{% endif %}
									</div>
								{% endfor %}
							{% endif %}
						</td>
					</tr>
				{% endfor %}
			</table>
		</details>
	{% endif %}

	{% for key, g in groups %}
		{% set count = g.set|length %}
		<details class="group" data-group="{{ key }}" open>
			<summary>
				<b>{{ g.title }}</b>
				<span class="small">{{ g.intro }}</span>
				<span class="pill {{ count ? 'up' : '' }}">{{ count }} set</span>
				{% if g.counts.default %}<span class="pill">{{ g.counts.default }} on default</span>{% endif %}
				{% if g.counts.off %}<span class="pill off">{{ g.counts.off }} off</span>{% endif %}
				{% if g.counts.unwritten %}<span class="pill stale">{{ g.counts.unwritten }} not written</span>{% endif %}
			</summary>

			<table class="opts">
				{% for o in g.set|merge(g.available) %}
					<tr class="opt state-{{ o.state }}" data-state="{{ o.state }}"
						data-name="{{ o.name }}" data-doc="{{ o.description|default('')|lower }}">
						<td class="name" data-label="Option">
							<code>{{ o.name }}</code>
							{% if o.state == 'set' %}<span class="tag set">set</span>
							{% elseif o.state == 'default' %}<span class="tag def">default {{ o.default }}</span>
							{% elseif o.state == 'off' %}<span class="tag off">off</span>
							{% else %}<span class="tag un">not written</span>{% endif %}
							{% if o.alias_of %}<div class="small stale">alias for {{ o.alias_of }}</div>{% endif %}
							{% if not o.known %}<div class="small warn">not in the schema</div>{% endif %}
							{% if features.overridden[o.name] is defined %}
								{# what is edited here is not what reaches the access point #}
								<div class="small override">overridden by <b>{{ features.overridden[o.name] }}</b>
									→ <code>{{ features.final[o.name] is iterable ? features.final[o.name]|join(', ') : (features.final[o.name] is same as(null) ? 'removed' : features.final[o.name]) }}</code></div>
							{% endif %}
						</td>
						<td class="val" data-label="Value">
							{% if o.is_list %}
								<textarea name="list[{{ o.name }}]" rows="{{ o.value ? o.value|length + 1 : 2 }}"
									placeholder="one entry per line">{{ o.value ? o.value|join("\n") }}</textarea>
							{% elseif o.type == 'boolean' %}
								<select name="opt[{{ o.name }}]">
									<option value="" {{ o.is_set ? '' : 'selected' }}>{% if o.default is not null %}— default ({{ o.default ? 'on' : 'off' }}) —{% else %}— not written, feature off —{% endif %}</option>
									<option value="1" {{ o.value in ['1','true','on','yes'] ? 'selected' }}>on</option>
									<option value="0" {{ o.is_set and o.value not in ['1','true','on','yes'] ? 'selected' }}>off</option>
								</select>
							{% elseif o.enum %}
								<select name="opt[{{ o.name }}]">
									<option value="">— default{% if o.default is not null %} ({{ o.default }}){% endif %} —</option>
									{% for e in o.enum %}<option value="{{ e }}" {{ o.value == e ? 'selected' }}>{{ e }}</option>{% endfor %}
								</select>
							{% else %}
								<input type="{{ o.type == 'number' ? 'number' : 'text' }}"
									name="opt[{{ o.name }}]" value="{{ o.value }}"
									{% if o.minimum is not null %}min="{{ o.minimum }}"{% endif %}
									{% if o.maximum is not null %}max="{{ o.maximum }}"{% endif %}
									placeholder="{{ o.default is not null ? 'default: ' ~ o.default : 'not set' }}">
							{% endif %}
						</td>
						<td class="doc small" data-label="What it does">
							{{ o.description ?: '' }}
							{% if o.description is empty %}<span class="stale">undocumented — neither OpenWrt nor we have a text for this one</span>
							{% elseif o.doc_source == 'apman' %}<span class="src" title="written here from the hostapd and mac80211 sources, because OpenWrt's schema leaves this option blank">our note</span>{% endif %}
							{% if o.default is not null %}<span class="stale"> Default: <code>{{ o.default }}</code>.</span>
							{% elseif o.state == 'off' %}<span class="stale"> Not written, so this function is off.</span>
							{% elseif o.state == 'unwritten' %}<span class="stale"> Not written — hostapd's own built-in default applies, which the schema does not state.</span>
							{% endif %}
							{% if o.type == 'number' and (o.minimum is not null or o.maximum is not null) %}
								<span class="stale"> Range {{ o.minimum ?? '…' }}–{{ o.maximum ?? '…' }}.</span>
							{% endif %}
						</td>
					</tr>
				{% endfor %}
			</table>
		</details>
	{% endfor %}
</form>
{% endblock %}

{% block javascripts %}
<script>
const rows = Array.from(document.querySelectorAll('tr.opt'));
const groups = Array.from(document.querySelectorAll('details.group'));

// Two filters at once: the "show everything" switch and the search box. An
// option stays visible when it is set, or when the switch is on, or when it
// matches the search — searching implies showing defaults, otherwise looking
// for something you have not set yet finds nothing.
const SCOPES = {
	set: ['set'],
	documented: ['set', 'default'],
	all: ['set', 'default', 'off', 'unwritten'],
};

const scopeSel = document.getElementById('scope');
const filterBox = document.getElementById('filter');
const shown = document.getElementById('shown');
const toggleAll = document.getElementById('toggleall');

// the last choice survives a reload — you rarely want a different one on the
// next network than on this one
const stored = localStorage.getItem('apman.ssid.scope');
if (stored && SCOPES[stored]) { scopeSel.value = stored; }

function apply() {
	const scope = SCOPES[scopeSel.value] || SCOPES.all;
	const q = filterBox.value.trim().toLowerCase();
	let count = 0;
	rows.forEach((tr) => {
		const inScope = scope.includes(tr.dataset.state);
		const hit = !q || tr.dataset.name.includes(q) || (tr.dataset.doc || '').includes(q);
		// a search always reaches into everything — looking for something you
		// have not switched on yet must not come up empty
		const visible = hit && (inScope || q);
		tr.style.display = visible ? '' : 'none';
		if (visible) { count++; }
	});
	programmatic = true;
	groups.forEach((d) => {
		const visible = d.querySelectorAll('tr.opt:not([style*="none"])').length;
		d.style.display = visible ? '' : 'none';
		// a group the user has not touched follows the view: searching or
		// asking for everything opens it, otherwise it stays as it was
		if (visible && !d.dataset.touched) { d.open = true; }
	});
	programmatic = false;
	shown.textContent = count + ' of ' + rows.length + ' options';
}

// opening a group from here must not count as the user having touched it,
// otherwise the first filter freezes every group in place
let programmatic = false;
groups.forEach((d) => d.addEventListener('toggle', () => {
	if (!programmatic) { d.dataset.touched = '1'; }
}));
scopeSel.addEventListener('change', () => {
	localStorage.setItem('apman.ssid.scope', scopeSel.value);
	groups.forEach((d) => delete d.dataset.touched);
	apply();
});
filterBox.addEventListener('input', apply);
toggleAll.addEventListener('click', () => {
	const open = toggleAll.textContent.trim() === 'open all';
	groups.forEach((d) => { d.dataset.touched = '1'; d.open = open; });
	toggleAll.textContent = open ? 'close all' : 'open all';
});
apply();

document.getElementById('editor').addEventListener('submit', async (ev) => {
	ev.preventDefault();
	const out = document.getElementById('result');
	const btn = ev.target.querySelector('button[type=submit]');
	btn.disabled = true;
	out.className = 'small';
	out.textContent = 'saving…';
	try {
		const res = await fetch(ev.target.action, { method: 'POST', body: new FormData(ev.target) });
		const d = await res.json();
		if (!d.ok) {
			out.className = 'small warn';
			out.textContent = d.error || 'failed';
		} else {
			out.className = 'small ok';
			out.textContent = d.hint + (d.changed.length ? ' (' + d.changed.join(', ') + ')' : '');
			if (d.changed.length) { setTimeout(() => location.reload(), 1500); }
		}
	} catch (e) {
		out.className = 'small warn';
		out.textContent = 'failed: ' + e;
	}
	btn.disabled = false;
});
</script>
{% endblock %}

{% block stylesheets %}
<style>
	.card { border: 1px solid #dde; border-radius: 4px; padding: .5rem .75rem; margin-bottom: 1rem; }
	.warnbox { border-color: #f0b7b2; background: #fdf3f2; }
	.warnbox ul { margin: .3rem 0 0 1rem; }
	.toolbar { position: sticky; top: 0; z-index: 5; background: #fff; padding: .5rem 0;
	           display: flex; gap: .75rem; align-items: center; border-bottom: 1px solid #dde; }
	.toolbar .spacer { flex: 1; }
	.toolbar input[type=search] { width: 22em; padding: .25rem .4rem; }
	details.group { border: 1px solid #dde; border-radius: 4px; margin: .5rem 0; }
	details.group > summary { padding: .45rem .6rem; cursor: pointer; background: #f7f9fc; }
	details.group > summary .small { color: #667; margin-left: .5rem; }
	details.group[open] > summary { border-bottom: 1px solid #dde; }
	table.opts { width: 100%; border-collapse: collapse; }
	table.opts td { border-top: 1px solid #eef; padding: .3rem .5rem; vertical-align: top; }
	td.name { width: 15em; }
	td.val { width: 18em; }
	td.val input, td.val select, td.val textarea { width: 100%; box-sizing: border-box; }
	td.doc { color: #445; }
	tr.state-set { background: #fbfdff; }
	tr.state-set td.name code { font-weight: 600; }
	tr.state-default td.name code,
	tr.state-off td.name code,
	tr.state-unwritten td.name code { color: #889; }
	.tag { font-size: .72em; border-radius: 8px; padding: 0 .4em; margin-left: .35em;
	       border: 1px solid; white-space: nowrap; }
	.tag.set { background: #e8f0fe; border-color: #b6ccf5; color: #24478f; }
	.tag.def { background: #eef7ee; border-color: #c3e0c3; color: #2f6b33; }
	.tag.off { background: #fff4e5; border-color: #f0d3a8; color: #8a5a10; }
	.tag.un  { background: #f4f4f6; border-color: #e0e0e6; color: #777; }
	/* an option a feature overwrites: what is edited here is not what arrives */
	.override { color: #8a5a10; }
	.override code { background: #fff4e5; border: 1px solid #f0d3a8; border-radius: 3px; padding: 0 .25em; }
	details.features > summary { background: #fbf7ef; }
	details.features .opt td { vertical-align: top; }
	.pill.off { background: #fff4e5; border-color: #f0d3a8; }
	.pill { background: #eef2f8; border: 1px solid #dde; border-radius: 10px; padding: 0 .45em; font-size: .85em; }
	.pill.up { background: #e8f5e9; border-color: #b8ddb9; }
	.pill.stale { background: #f4f4f6; color: #778; }
	.legend { color: #667; margin: .4rem 0 .8rem; line-height: 1.9; }
	.legend .tag, .legend .src { margin-left: 0; }
	button.ghost { background: #f7f9fc; border: 1px solid #dde; border-radius: 3px;
	               padding: .15rem .5rem; cursor: pointer; }
	.src { font-size: .72em; border: 1px solid #dcd6ea; background: #f3f0fa; color: #5b4f86;
	       border-radius: 8px; padding: 0 .4em; margin-left: .3em; white-space: nowrap; cursor: help; }
</style>
{% endblock %}
