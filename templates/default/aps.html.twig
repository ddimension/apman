{% extends 'frontend.html.twig' %}

{% block body %}
<h2>Access Points</h2>

{% if channel_map|length %}
<h3>On the air</h3>
<p class="small stale">
	Which radios share a frequency, and the colour each one runs. Grouped by frequency, not by
	channel number — hostapd reports sometimes the control and sometimes the centre channel.
	The colour is hostapd's own choice, not ours: it picks one and changes it when it sees a
	collision, so two radios here with the same colour on one row is a real problem and the
	configured value says nothing about it.
</p>
<table class="chanmap">
	<tr><th>frequency</th><th>radios</th><th>colour</th><th>bss</th><th>htmode</th><th>airtime</th></tr>
	{% for freq, group in channel_map %}
		{% for r in group.radios %}
			<tr class="{{ loop.first ? 'first' : '' }}">
				{% if loop.first %}
					<td rowspan="{{ group.radios|length }}">
						<b>{{ freq }} MHz</b>
						<div class="stale">ch {{ r.channel }}{% if group.radios|length > 1 %} · {{ group.radios|length }} radios{% endif %}</div>
					</td>
				{% endif %}
				<td>
					<a href="{{ path('radio_detail', {'id': r.radio_id}) }}">{{ r.ap }}/{{ r.radio }}</a>
					{% if r.cac and r.cac.active %}
						<span class="pill {{ r.cac.overdue ? 'down' : '' }}"
						      title="listening for {{ r.cac.elapsed }}s of {{ r.cac.expected }} expected{% if r.cac.overdue %}, past the {{ r.cac.deadline }}s allowed{% endif %}">
							CAC {{ r.cac.left is not null ? r.cac.left ~ 's' : r.cac.elapsed ~ 's' }}{{ r.cac.overdue ? ' overdue' : '' }}
						</span>
					{% elseif r.cac and r.cac.outcome == 'moved' %}
						<div class="warn small" title="a check finished on another frequency, so radar moved it">radar moved it</div>
					{% endif %}
					{% if r.wanted and r.wanted != 'auto' and r.wanted != r.channel~'' %}
						<div class="warn small">configured {{ r.wanted }}</div>
					{% endif %}
				</td>
				<td class="{{ group.clash ? 'warn' : '' }}">{{ r.colour is null ? '—' : r.colour }}</td>
				<td>{{ r.bss }}</td>
				<td class="small">{{ r.htmode ?: 'auto' }}</td>
				<td>{% if r.airtime is not null %}{{ (r.airtime * 100 / 255)|round }}%{% else %}—{% endif %}</td>
			</tr>
		{% endfor %}
	{% endfor %}
</table>
{% endif %}

<table class="aps">
	<tr>
		<th>AP</th><th>State</th><th>Agent</th><th>Features</th><th>Intervals</th>
	</tr>
	{% for ap in aps %}
		<tr class="ap {{ ap.online == 'online' ? 'up' : 'down' }}">
			<td><b><a href="{{ path('ap_detail', {'name': ap.name}) }}">{{ ap.name }}</a></b>{% if not ap.productive %} <i>(non productive)</i>{% endif %}</td>
			<td>{{ ap.state }}{% if ap.online %} / {{ ap.online }}{% endif %}</td>
			<td>
				{% if ap.agent %}
					{{ ap.agent.agent|default('apman') }} {{ ap.agent.version|default('?') }}
				{% else %}
					<span class="warn">unknown (old agent)</span>
				{% endif %}
			</td>
			<td class="small">
				{% if ap.agent and ap.agent.features is defined %}
					{{ ap.agent.features|join(', ') }}
				{% endif %}
			</td>
			<td class="small">
				{% if ap.agent and ap.agent.intervals is defined %}
					status {{ ap.agent.intervals.status|default('?') }}s,
					probe {{ ap.agent.intervals.probe|default('?') }}s,
					survey {{ ap.agent.intervals.survey|default('?') }}s
				{% endif %}
			</td>
		</tr>
		{% for dev in ap.devices %}
			<tr class="dev">
				<td>&nbsp;&nbsp;{{ dev.ifname }}</td>
				<td>
					{% if dev.ssid_configured %}{{ dev.ssid_configured }}{% endif %}
					{% if dev.channel %}<span class="small">ch {{ dev.channel }}</span>{% endif %}
					{% if dev.bss_color is defined and dev.bss_color is not null and dev.bss_color >= 0 %}
						<span class="small">color {{ dev.bss_color }}</span>
					{% endif %}
				</td>
				<td>
					{# MLO: one bss can span several radio links #}
					{% if dev.mld %}
						<span class="mld">MLO</span>
						{% for idx, link in dev.mld %}
							<div class="small">link {{ link.radio|default(idx) }}:
								{{ link.macaddr|default('') }}
								{{ link.running|default(false) ? 'up' : 'down' }}
								{% if link.pending|default(false) %}(pending){% endif %}
							</div>
						{% endfor %}
					{% else %}
						<span class="small">
							{% if dev.wiphy %}{{ dev.wiphy }}{% endif %}
							{% if dev.radio_idx is not null %}/radio {{ dev.radio_idx }}{% endif %}
							{% if dev.running is not null %}{{ dev.running ? 'up' : 'down' }}{% endif %}
						</span>
					{% endif %}
				</td>
				<td>
					{# what hostapd really runs, compared against our config #}
					{% if dev.drift %}
						{% for key, val in dev.drift %}
							<div class="small {{ key == 'ssid' ? 'warn' : '' }}">
								{{ key }}: {{ val.running }}
								{% if val.configured is defined %} (configured: {{ val.configured }}){% endif %}
							</div>
						{% endfor %}
					{% elseif dev.bss_info %}
						<span class="small ok">matches config</span>
						{% if dev.security %}
							<div class="small">{% for k, v in dev.security %}{{ k }}={{ v }} {% endfor %}</div>
						{% endif %}
					{% else %}
						<span class="small">no bss_info</span>
					{% endif %}
				</td>
				<td class="small">
					{# 802.11k/v activity counters straight from hostapd #}
					{% if dev.rrm %}nr_tx {{ dev.rrm.neighbor_report_tx|default(0) }}{% endif %}
					{% if dev.wnm %}
						| bss-tr req {{ dev.wnm.bss_transition_request_tx|default(0) }}
						resp {{ dev.wnm.bss_transition_response_rx|default(0) }}
						query {{ dev.wnm.bss_transition_query_rx|default(0) }}
					{% endif %}
					{% if dev.survey %}
						<div>quietest: {% for c in dev.survey.best %}{{ c.mhz }}MHz {{ c.busy_pct }}%{% if c.noise %}/{{ c.noise }}dBm{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
							<i>({{ dev.survey.channels }} ch)</i></div>
					{% endif %}
				</td>
			</tr>
		{% endfor %}
	{% endfor %}
</table>

<h2>802.11v steering, last 24h</h2>
<p>
	{{ steering.total }} transition responses,
	<span class="ok">{{ steering.accepted }} accepted</span>,
	<span class="warn">{{ steering.rejected }} rejected</span>
	{% if steering.total > 0 %}
		({{ (steering.accepted * 100 / steering.total)|round(1) }}% accepted)
	{% endif %}
</p>
{% if steering.by_client|length %}
<table class="aps">
	<tr><th>Client</th><th>accepted</th><th>rejected</th></tr>
	{% for mac, s in steering.by_client %}
		<tr><td>{{ mac }}</td><td>{{ s.accepted }}</td>
			<td class="{{ s.rejected and not s.accepted ? 'warn' : '' }}">{{ s.rejected }}</td></tr>
	{% endfor %}
</table>
<p class="small">Clients that only ever reject are candidates for
	<i>steering_disabled</i>: every attempt costs a frame and achieves nothing.</p>
{% endif %}
{% endblock %}

{% block stylesheets %}
<style>

	table.chanmap { border-collapse: collapse; margin: .5em 0 1.5em; }
	table.chanmap th, table.chanmap td { padding: .3em 1em .3em 0; text-align: left;
	                                     vertical-align: top; border-bottom: 1px solid var(--line-soft); }
	table.chanmap th { font-weight: 600; border-bottom: 1px solid var(--line-strong); }
	table.chanmap tr.first td { border-top: 1px solid #ddd; }
	table.chanmap .stale { color: var(--ink-mute); font-size: .85em; font-style: normal; }
	table.chanmap .warn { color: var(--warn-strong); font-weight: 600; }
	tr.ap { background: #eef; }
	tr.ap.down { background: #fee; }
	tr.dev td:first-child { padding-left: 1.5em; }
	.mld { background: var(--good-bg); padding: 0 4px; border-radius: var(--r-sm); }
</style>

{% endblock %}
