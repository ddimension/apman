{% extends 'frontend.html.twig' %}
{% block title %}{{ ap.name }}{% endblock %}

{% block body %}
<h2>{{ ap.name }}
	<span class="pill {{ tree.state_name in ['ACTIVE', 'READY'] ? 'up' : 'down' }}">{{ tree.state_name }}</span>
</h2>

<p class="small">
	{% if agent %}
		Agent {{ agent.version|default('?') }} — {{ agent.features|default([])|join(', ') }}
	{% else %}
		<span class="warn">no agent inventory (agent older than 56-2)</span>
	{% endif %}
	{% if board and board.release is defined %}
		<br>{{ board.model|default('') }} — {{ board.release.description|default('') }}
	{% endif %}
	{% if sysinfo and sysinfo.uptime is defined %}
		<br>uptime {{ (sysinfo.uptime // 3600) }}h, load {{ sysinfo.load[0]|default('?') }}
	{% endif %}
	{# which hostapd, because sae_pwe and the SAE rules mean different things
	   on each and the consistency page judges this access point by it #}
	{% if hostapd_build.known|default(false) %}
		<br>hostapd: {{ hostapd_build.package }} {{ hostapd_build.version|default('') }}
		{% if hostapd_build.patched %}
			<span class="pill up">SAE over RADIUS</span>
		{% else %}
			<span class="pill">stock — a RADIUS password has no SAE PT here</span>
		{% endif %}
	{% else %}
		<br><span class="warn">hostapd build unknown{% if hostapd_build.why|default(false) %}
			— {{ hostapd_build.why }}{% endif %}</span>
	{% endif %}
</p>

{# The access point as a tree. Every node says what it is and how long it has
   been that: the radio carries the DFS state, the bsses under it carry theirs,
   and what the access point is follows from them rather than being guessed at
   the top. #}
<table class="aps">
	<tr><th>Node</th><th>State</th><th>Since</th><th>Last heard</th></tr>
	<tr>
		<td><b>{{ tree.name }}</b></td>
		<td><span class="pill {{ tree.state_name in ['ACTIVE', 'READY'] ? 'up' : 'down' }}">{{ tree.state_name }}</span></td>
		<td class="small">{{ tree.since ? ((date().timestamp - tree.since) // 60) ~ ' min' : '—' }}</td>
		<td class="small">{{ tree.seen ? (date().timestamp - tree.seen) ~ ' s' : 'never' }}{{ tree.fresh ? '' : ' (stale)' }}</td>
	</tr>
	{% for radio in tree.children %}
		<tr>
			<td>&nbsp;&nbsp;{% if radio.id %}<a href="{{ path('radio_detail', {'id': radio.id}) }}">{{ radio.name }}</a>{% else %}{{ radio.name }}{% endif %}</td>
			<td>{{ radio.state_name }}</td>
			<td class="small">{{ radio.since ? ((date().timestamp - radio.since) // 60) ~ ' min' : '—' }}</td>
			<td class="small">{{ radio.seen ? (date().timestamp - radio.seen) ~ ' s' : 'never' }}</td>
		</tr>
		{% for bss in radio.children %}
			<tr class="small">
				<td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ bss.name }}</td>
				<td>{{ bss.state_name }}</td>
				<td>{{ bss.since ? ((date().timestamp - bss.since) // 60) ~ ' min' : '—' }}</td>
				<td>{{ bss.seen ? (date().timestamp - bss.seen) ~ ' s' : 'never' }}</td>
			</tr>
		{% endfor %}
	{% endfor %}
</table>

{% if uplinks|length %}
<p class="small">
	{% for u in uplinks %}
		Plugged into <b>{{ u.switch }}</b>{% if u.model %} ({{ u.model }}){% endif %}
		on port <span class="mono">{{ u.port }}</span> via <span class="mono">{{ u.local }}</span>{#
		#}{% if u.link %}, {{ u.link|split(' - ')|first }}{% endif %}{#
		#}{% if u.poe_mw %}, drawing power over ethernet — {{ (u.poe_mw / 1000)|round(1) }} W set aside as {{ u.poe_class }}{% endif %}.
		<a href="{{ path('topology') }}">the rest of the fleet</a>
	{% endfor %}
</p>
{% endif %}

<p>
	<button type="button" id="dryrun">Show pending changes</button>
	<button type="button" id="classify">What would it cost?</button>
	<button type="button" id="provision">Provision under running radios</button>
	<button type="button" id="restart">Provision with restart</button>
	<span class="small stale">
		under running radios: the networks that changed are started and stopped one by one and the
		rest keep going — refused if a radio option changed, because that takes the whole phy down.
		With restart: radios down, wait until the netdevs are really gone, one second, configure,
		radios up. A radio listening on a dfs channel is waited for rather than called a failure.
	</span>
</p>
<table id="phases" class="counters small" style="display:none">
	<tr><th>step</th><th>took</th><th></th></tr>
</table>
<div id="actionresult" class="small"></div>
<pre id="diff" class="small" style="display:none; background:#f6f6f6; padding:.5rem; overflow:auto"></pre>

{% if syslog_counters or syslog|length %}
<div class="card">
	<h3 class="small" style="margin:0 0 .3em">
		What it has been saying
		<a href="{{ path('syslog', {'ap': ap.name}) }}" class="small">all of it</a>
	</h3>
	{% if syslog_counters %}
		<p class="small stale" style="margin:0 0 .5em">
			{{ syslog_counters.enabled ? (syslog_counters.attached ? 'attached to the log stream' : 'switched on, not attached') : 'switched off' }}
			· read {{ syslog_counters.records|default(0) }}
			· forwarded {{ syslog_counters.forwarded|default(0) }}
			· its own {{ syslog_counters.own|default(0) }}
			· dropped {{ syslog_counters.dropped|default(0) }}
		</p>
	{% endif %}
	{% if syslog|length %}
		<table class="counters small">
			{% for line in syslog %}
				<tr>
					<td class="mono">{{ line.ts|date('d.m. H:i:s') }}</td>
					<td class="{{ line.level is not null and line.level <= 4 ? 'warn' : 'stale' }}">{{ line.level_name ?: '' }}</td>
					<td class="mono">{{ line.ident ?: (line.source == 'kernel' ? 'kernel' : '') }}</td>
					<td class="mono">{{ line.text }}</td>
				</tr>
			{% endfor %}
		</table>
	{% else %}
		<p class="small stale">Nothing has arrived yet.</p>
	{% endif %}
</div>
{% endif %}

{% for dev in devices %}
	<h3><a href="{{ path('device_detail', {'id': dev.id}) }}">{{ dev.ifname }}</a>
		{% if dev.ssid %}<span class="small">{{ dev.ssid }}</span>{% endif %}
		{% if dev.age is not null %}
			<span class="small {{ dev.age > 60 ? 'stale' : '' }}">state {{ dev.age }}s old</span>
		{% endif %}
	</h3>

	<table class="aps">
		<tr>
			<th>Radio</th><th>Channel</th><th>Links</th><th>Security</th><th>802.11k/v</th><th>Survey</th>
		</tr>
		<tr>
			<td>{{ dev.radio }}{% if dev.band %} ({{ dev.band }}){% endif %}
				{% if dev.hostapd_status.wiphy is defined %}<div class="small">{{ dev.hostapd_status.wiphy }}</div>{% endif %}
			</td>
			<td>
				{% if dev.ap_status.channel is defined %}{{ dev.ap_status.channel }}{% endif %}
				{% if dev.ap_status.freq is defined %}<div class="small">{{ dev.ap_status.freq }} MHz</div>{% endif %}
				{% if dev.ap_status.status is defined %}<div class="small">{{ dev.ap_status.status }}</div>{% endif %}
				{% if dev.ap_status.dfs is defined and dev.ap_status.dfs.cac_active %}
					<div class="warn small">CAC active, {{ dev.ap_status.dfs.cac_seconds_left|default('?') }}s left</div>
				{% endif %}
				{% if dev.ap_status.airtime is defined and dev.ap_status.airtime.utilization is defined %}
					<div class="small">airtime {{ (dev.ap_status.airtime.utilization * 100 / 255)|round }}%</div>
				{% endif %}
			</td>
			<td>
				{% if dev.hostapd_status.links is defined and dev.hostapd_status.links %}
					<span class="pill up">MLO</span>
					{% for idx, link in dev.hostapd_status.links %}
						<div class="small">link {{ link.radio|default(idx) }} {{ link.macaddr|default('') }}
							{{ link.running|default(false) ? 'up' : 'down' }}</div>
					{% endfor %}
				{% else %}
					<span class="small">single link
						{% if dev.hostapd_status.macaddr is defined %}{{ dev.hostapd_status.macaddr }}{% endif %}</span>
				{% endif %}
			</td>
			<td class="small">
				{% if dev.bss_info %}
					wpa={{ dev.bss_info.wpa|default('-') }}<br>
					{{ dev.bss_info.wpa_key_mgmt|default('') }}<br>
					pmf={{ dev.bss_info.ieee80211w|default('-') }},
					mode={{ dev.bss_info.hw_mode|default('-') }}
					{% if dev.bss_info.ssid is defined and dev.ssid and dev.bss_info.ssid != dev.ssid %}
						<div class="warn">running SSID "{{ dev.bss_info.ssid }}" differs from "{{ dev.ssid }}"</div>
					{% endif %}
				{% else %}
					<span class="stale">no bss_info</span>
				{% endif %}
			</td>
			<td class="small">
				{% if dev.ap_status.rrm is defined %}nr_tx {{ dev.ap_status.rrm.neighbor_report_tx|default(0) }}<br>{% endif %}
				{% if dev.ap_status.wnm is defined %}
					req {{ dev.ap_status.wnm.bss_transition_request_tx|default(0) }},
					resp {{ dev.ap_status.wnm.bss_transition_response_rx|default(0) }},
					query {{ dev.ap_status.wnm.bss_transition_query_rx|default(0) }}
				{% endif %}
			</td>
			<td class="small">
				{% if dev.survey %}
					{% for c in dev.survey.best %}{{ c.mhz }}MHz {{ c.busy_pct }}%{% if c.noise %} / {{ c.noise }}dBm{% endif %}<br>{% endfor %}
					<i>{{ dev.survey.channels }} channels</i>
				{% else %}
					<span class="stale">no survey</span>
				{% endif %}
			</td>
		</tr>
	</table>

	{% if dev.mib %}
	<table class="aps mib">
		<tr>
			<th>Authentication <span class="small">hostapd MIB counters</span></th>
			<th>RADIUS</th>
		</tr>
		<tr>
			<td class="small">
				{% for key, value in dev.mib.security %}
					<span class="{{ key == '4-way handshake failures' and value > 0 ? 'warn' : '' }}">
						{{ key }}: <b>{{ value }}</b></span><br>
				{% endfor %}
			</td>
			<td class="small">
				{% if dev.mib.radius is defined %}
					server {{ dev.mib.radius.server }},
					<span class="{{ dev.mib.radius['round trip']|replace({' ms': ''})|number_format > 200 ? 'warn' : '' }}">rtt {{ dev.mib.radius['round trip'] }}</span><br>
					{{ dev.mib.radius.accepts }} accepted of {{ dev.mib.radius.requests }} requests<br>
					<span class="{{ dev.mib.radius.rejects > 0 ? 'warn' : '' }}">{{ dev.mib.radius.rejects }} rejected</span>,
					<span class="{{ dev.mib.radius.timeouts > 0 ? 'warn' : '' }}">{{ dev.mib.radius.timeouts }} timed out</span>,
					{{ dev.mib.radius.retransmissions }} retransmitted
					{% if dev.mib.radius['bad or malformed answers'] is defined %}
						<br><span class="warn">{{ dev.mib.radius['bad or malformed answers'] }} bad or malformed answers</span>
					{% endif %}
				{% else %}
					<span class="stale">no radius on this bss</span>
				{% endif %}
			</td>
		</tr>
	</table>
	{% endif %}

	{% if dev.events|length %}
	<table class="aps">
		<tr><th colspan="4">hostapd events <span class="small">from the control channel — refusals, EAP verdicts, channel changes</span></th></tr>
		{% for e in dev.events %}
			<tr>
				<td class="small">{{ e.age }}s ago</td>
				<td class="small {{ e.bad ? 'warn' : '' }}"><b>{{ e.event }}</b></td>
				<td class="small">
					{% if e.address %}<a href="{{ path('client_detail', {'mac': e.address}) }}">{{ e.address }}</a>{% endif %}
				</td>
				<td class="small stale">{{ e.detail }}</td>
			</tr>
		{% endfor %}
	</table>
	{% endif %}

	{% if dev.clients|length %}
	<table class="aps">
		<tr><th>Client</th><th>Identity</th><th>Signal</th><th>Rate rx/tx</th><th>Idle</th><th>Interface</th><th>Actions</th></tr>
		{% for mac, c in dev.clients %}
			<tr>
				<td><a href="{{ path('client_detail', {'mac': mac}) }}">{{ mac }}</a></td>
				<td class="small">
					{% if c.identity %}<span class="pill up">{{ c.identity }}</span>{% endif %}
					{% if c.akm %}<div class="stale">{{ c.akm }}</div>{% endif %}
				</td>
				<td>
					{% if c.signal is not null %}
						{% set pct = ((c.signal + 100) * 100 / 60)|round %}
						<span class="bar {{ c.signal < -75 ? 'bad' : (c.signal < -65 ? 'weak' : '') }}">
							<span style="width: {{ pct < 0 ? 0 : (pct > 100 ? 100 : pct) }}%"></span></span>
						{{ c.signal }} dBm
					{% endif %}
				</td>
				<td class="small">{{ c.rx_rate is not null ? (c.rx_rate / 1000)|round : '?' }} /
					{{ c.tx_rate is not null ? (c.tx_rate / 1000)|round : '?' }} Mbit</td>
				<td class="small">{{ c.inactive is not null ? (c.inactive / 1000)|round : '?' }}s</td>
				<td class="small">{{ c.device }}</td>
				<td>
					<button type="button" class="act" data-object="hostapd.{{ dev.ifname }}"
						data-method="del_client"
						data-args='{"addr":"{{ mac }}","reason":5,"deauth":false,"ban_time":10}'>Kick</button>
					<button type="button" class="act" data-object="hostapd.{{ dev.ifname }}"
						data-method="rrm_beacon_req"
						data-args='{"addr":"{{ mac }}","mode":2,"duration":100,"channel":0,"op_class":0}'>Beacon req</button>
				</td>
			</tr>
		{% endfor %}
	</table>
	{% else %}
		<p class="small">no associated clients</p>
	{% endif %}

	<p class="small">
		<button type="button" class="act" data-object="hostapd.{{ dev.ifname }}"
			data-method="update_beacon" data-args="{}">Update beacon</button>
		<button type="button" class="act" data-object="hostapd.{{ dev.ifname }}"
			data-method="get_status" data-args="{}">Read status</button>
		<button type="button" class="act" data-object="iwinfo"
			data-method="survey" data-args='{"device":"{{ dev.ifname }}"}'>Run survey</button>
	</p>
{% endfor %}

<script>
// provisioning stages everything in one uci transaction, asks the ap for the
// resulting diff and only then applies it, with rpcd's rollback timer armed
async function provision(dry) {
	const out = document.getElementById('actionresult');
	const diff = document.getElementById('diff');
	out.className = 'small';
	out.textContent = dry ? 'collecting pending changes...' : 'provisioning...';
	diff.style.display = 'none';
	try {
		const res = await fetch('{{ path('ap_provision', {'name': ap.name}) }}', {
			method: 'POST', body: new URLSearchParams({ dry: dry ? '1' : '' })
		});
		const d = await res.json();
		out.className = 'small ' + (d.ok ? 'ok' : 'warn');
		let msg = (dry ? 'dry run: ' : '') + (d.error || d.note || 'ok');
		if (d.change_count !== undefined) { msg += ' — ' + d.change_count + ' change(s)'; }
		if (d.commands) { msg += ', ' + d.commands + ' command(s)'; }
		if (d.failed && Object.keys(d.failed).length) {
			msg += ' — failed: ' + Object.entries(d.failed).slice(0, 3).map(([k, v]) => k + ': ' + v).join('; ');
		}
		out.textContent = msg;
		const detail = d.changes || d.staged;
		if (detail) { diff.textContent = JSON.stringify(detail, null, 1); diff.style.display = 'block'; }
	} catch (e) {
		out.className = 'small warn';
		out.textContent = 'failed: ' + e;
	}
}
document.getElementById('dryrun').addEventListener('click', () => provision(true));

// Applying underneath running radios answers the same way the restart flow
// does — a step per phase — plus what actually moved. That last part is the
// one worth having: a bss that was torn down and rebuilt comes back under the
// same name and looks identical in every list, but the kernel gives it a new
// interface index, so an index that did not change is a network that did not
// notice.
async function provisionLive(force) {
	const out = document.getElementById('actionresult');
	const phases = document.getElementById('phases');
	const diff = document.getElementById('diff');
	out.className = 'small';
	out.textContent = 'asking what would change…';
	diff.style.display = 'none';
	phases.style.display = 'none';
	while (phases.rows.length > 1) { phases.deleteRow(1); }
	try {
		const body = { };
		if (force) { body.force = '1'; }
		const res = await fetch('{{ path('ap_provision', {'name': ap.name}) }}', {
			method: 'POST', body: new URLSearchParams(body)
		});
		const d = await res.json();
		out.className = 'small ' + (d.ok ? 'ok' : 'warn');
		if (d.ok) {
			let msg = 'done — ' + (d.kept || []).length + ' kept running';
			if ((d.added || []).length) { msg += ', added ' + d.added.join(', '); }
			if ((d.removed || []).length) { msg += ', removed ' + d.removed.join(', '); }
			if ((d.restarted || []).length) { msg += ' — but these restarted: ' + d.restarted.join(', '); }
			if (!d.known) { msg += ' (the interface indices could not be read, so this run cannot say)'; }
			out.textContent = msg;
			if ((d.restarted || []).length) { out.className = 'small warn'; }
		} else {
			out.textContent = d.error || 'that did not work';
		}
		(d.steps || []).forEach((s) => {
			const row = phases.insertRow(-1);
			row.insertCell(-1).textContent = s.step;
			row.insertCell(-1).textContent = s.ms + ' ms';
			const c = row.insertCell(-1);
			c.textContent = (s.ok ? '' : 'failed — ') + (s.detail || '');
			c.className = s.ok ? 'stale' : 'warn';
		});
		if (phases.rows.length > 1) { phases.style.display = ''; }
		if (d.needs_restart) {
			diff.textContent = 'These radios change, and each takes every network on it down:\n\n'
				+ d.needs_restart.map((r) => '  ' + r + '\n'
					+ ((d.classify.radios[r] || {}).reasons || []).map((x) => '      ' + x).join('\n')).join('\n');
			diff.style.display = 'block';
		}
	} catch (e) {
		out.className = 'small warn';
		out.textContent = 'failed: ' + e;
	}
}
document.getElementById('provision').addEventListener('click', () => provisionLive(false));

// The same check on its own, changing nothing. Worth a button of its own
// because the answer decides whether this is a five second job or a ten minute
// one on a dfs radio.
document.getElementById('classify').addEventListener('click', async () => {
	const out = document.getElementById('actionresult');
	const diff = document.getElementById('diff');
	out.className = 'small';
	out.textContent = 'asking the access point…';
	try {
		const res = await fetch('{{ path('api_ap_provision_classify', {'name': ap.name}) }}', { method: 'POST' });
		const d = await res.json();
		if (!d.ok) { out.className = 'small warn'; out.textContent = d.error; return; }
		out.className = 'small ' + (d.mode === 'live' ? 'ok' : 'warn');
		out.textContent = d.mode === 'live'
			? 'the next run changes only networks and disturbs nothing'
			: 'the next run restarts ' + d.restarting.join(', ') + ', taking every network on them down';
		diff.textContent = Object.keys(d.radios).map((name) => {
			const r = d.radios[name];
			return name + '  ' + r.mode + '  ' + r.devices + ' network(s)\n'
				+ r.reasons.map((x) => '      ' + x).join('\n');
		}).join('\n');
		diff.style.display = 'block';
	} catch (e) {
		out.className = 'small warn';
		out.textContent = 'failed: ' + e;
	}
});

// The restart flow answers with a step per phase and what each one cost, which
// is the point of it: a step two that took nineteen seconds is worth seeing,
// and so is a radio that is lawfully listening rather than missing.
async function provisionRestart() {
	const out = document.getElementById('actionresult');
	const phases = document.getElementById('phases');
	const diff = document.getElementById('diff');
	out.className = 'small';
	out.textContent = 'radios down, waiting for the interfaces to go…';
	diff.style.display = 'none';
	phases.style.display = 'none';
	while (phases.rows.length > 1) { phases.deleteRow(1); }
	try {
		const res = await fetch('{{ path('ap_provision', {'name': ap.name}) }}', {
			method: 'POST', body: new URLSearchParams({ restart: '1' })
		});
		const d = await res.json();
		out.className = 'small ' + (d.ok ? 'ok' : 'warn');
		out.textContent = d.error || (d.cac
			? 'done — still listening on ' + Object.keys(d.cac).join(', ')
			: 'done');
		(d.steps || []).forEach((s) => {
			const row = phases.insertRow(-1);
			row.insertCell(-1).textContent = s.step;
			row.insertCell(-1).textContent = s.ms + ' ms';
			const c = row.insertCell(-1);
			c.textContent = (s.ok ? '' : 'failed — ') + (s.detail || '');
			c.className = s.ok ? 'stale' : 'warn';
		});
		if (phases.rows.length > 1) { phases.style.display = ''; }
		if (d.config && (d.config.changes || d.config.staged)) {
			diff.textContent = JSON.stringify(d.config.changes || d.config.staged, null, 1);
			diff.style.display = 'block';
		}
	} catch (e) {
		out.className = 'small warn';
		out.textContent = 'failed: ' + e;
	}
}
document.getElementById('restart').addEventListener('click', provisionRestart);

// every action goes through the agent and reports back what actually happened:
// command channel v2 answers with a result or an error object
document.querySelectorAll('button.act').forEach((btn) => {
	btn.addEventListener('click', async () => {
		const out = document.getElementById('actionresult');
		const label = btn.dataset.object + ' ' + btn.dataset.method;
		btn.disabled = true;
		out.textContent = label + ': running...';
		out.className = 'small';
		try {
			const body = new URLSearchParams({
				object: btn.dataset.object,
				method: btn.dataset.method,
				args: btn.dataset.args || '{}'
			});
			const res = await fetch('{{ path('ap_action', {'name': ap.name}) }}', {
				method: 'POST', body: body
			});
			const data = await res.json();
			if (data.ok) {
				out.className = 'small ok';
				out.textContent = label + ': ok' +
					(data.result ? ' — ' + JSON.stringify(data.result).slice(0, 300) : '');
			} else {
				out.className = 'small warn';
				out.textContent = label + ': ' + (data.error || 'failed');
			}
		} catch (e) {
			out.className = 'small warn';
			out.textContent = label + ': ' + e;
		}
		btn.disabled = false;
	});
});
</script>
{% endblock %}
