{% extends 'frontend.html.twig' %}
{% block title %}{{ ap ? ap.name ~ ' ' : '' }}{{ radio.name }}{% endblock %}

{% block body %}
<h2>
	{% if ap %}<a href="{{ path('ap_detail', {'name': ap.name}) }}">{{ ap.name }}</a> {% endif %}
	{{ radio.name }} <span class="small">radio configuration</span>
</h2>

<p class="small">
	These options are written into the <i>wifi-device</i> section of this access point. They
	belong to the radio, not to a network: a channel, a transmit power or a bss colour is one
	value for every bss on this radio. The descriptions come from OpenWrt's own
	<code>wifi-device.json</code> — 152 options, of which the admin form used to show nineteen.
</p>

<div class="card">
	<p class="small">
		<b>Carries</b>
		{% if bss|length %}
			{{ bss|length }} bss —
			{% for b in bss %}
				<span class="stale">{{ b.ssid ?: b.name }}/{{ b.ifname ?: '(no name)' }}</span>
				<span class="pill {{ b.state == 'ACTIVE' ? 'up' : (b.state in ['ABSENT','UNKNOWN'] ? 'down' : '') }}">{{ b.state }}</span>{{ not loop.last ? ' · ' }}
			{% endfor %}
		{% else %}
			nothing. A radio with no bss is configured and silent.
		{% endif %}
	</p>
	<p class="small stale">
		Changing anything here rebuilds every one of those bsses at the next provisioning run,
		and the stations on them are dropped. Saving alone reaches no access point.
	</p>
</div>

{% if running.freq is defined %}
<div class="card">
	<h3 class="small" style="margin:0 0 .5em">What the radio is doing</h3>
	<div class="stats">
		<div class="stat{{ running.drifted ? ' warn' : '' }}">
			<b>{{ running.channel }}</b>
			<span>channel · {{ running.freq }} MHz{% if running.op_class is defined %}, class {{ running.op_class }}{% endif %}</span>
			{% if running.drifted %}<span class="warn">configured {{ running.wanted_channel }} — moved, most likely by DFS</span>
			{% elseif running.wanted_channel is null %}<span class="stale">chosen by the access point</span>
			{% endif %}
		</div>
		<div class="stat">
			<b>{% if running.bss_color is defined and running.bss_color >= 0 %}{{ running.bss_color }}{% else %}—{% endif %}</b>
			<span>bss colour</span>
			<span class="stale">{% if running.bss_color is defined and running.bss_color >= 0 %}hostapd picks and re-picks this itself{% else %}none reported — this radio is not running HE{% endif %}</span>
		</div>
		{% if running.airtime is defined and running.airtime.utilization is defined %}
		<div class="stat">
			<b>{{ (running.airtime.utilization * 100 / 255)|round }}%</b>
			<span>airtime in use</span>
			<span class="stale">{{ running.airtime.utilization }} of 255</span>
		</div>
		{% endif %}
		{% if running.dfs is not defined and dfs is not null and dfs.probe is not defined and dfs_why %}
		<div class="stat">
			<b>{{ radio_state }}</b>
			<span>dfs</span>
			<span class="stale">{{ dfs_why }}</span>
		</div>
		{% endif %}
		{% if running.dfs is not defined and dfs and dfs.probe is defined %}
		<div class="stat{{ dfs.probe.checking ? ' warn' : '' }}">
			<b>{% if dfs.probe.checking %}{{ dfs.probe.left is not null ? dfs.probe.left ~ 's' : 'listening' }}{% else %}{{ dfs.probe.state|lower }}{% endif %}</b>
			<span>dfs · asked just now</span>
			<span class="stale">
				{% if dfs.probe.checking %}the radio is listening on {{ dfs.probe.freq }} MHz and needs
					{{ dfs.probe.expected }}s before it may transmit — no bss exists until it is done,
					which is why nothing else on this page knows about it
				{% else %}hostapd says {{ dfs.probe.state }} on {{ dfs.probe.freq }} MHz{% endif %}
			</span>
		</div>
		{% endif %}
		{% if running.dfs is defined %}
		<div class="stat{{ dfs and dfs.active ? (dfs.overdue ? ' bad' : ' warn') : '' }}">
			<b>{% if dfs and dfs.active %}{{ dfs.left is not null ? dfs.left ~ 's' : (dfs.elapsed ~ 's') }}{% else %}clear{% endif %}</b>
			<span>dfs{% if running.dfs.cac_seconds %} · {{ running.dfs.cac_seconds }}s expected{% endif %}</span>
			{% if dfs and dfs.active %}
				<span class="cacbar{{ dfs.overdue ? ' over' : '' }}"><span
					style="width: {{ dfs.expected ? min(100, (dfs.elapsed * 100 / dfs.expected)|round) : 0 }}%"></span></span>
				<span class="{{ dfs.overdue ? 'warn' : 'stale' }}">
					listening for {{ dfs.elapsed }}s of {{ dfs.expected }}, no traffic until it ends{% if dfs.overdue %} —
					past the {{ dfs.deadline }}s this radio is allowed{% endif %}
				</span>
			{% elseif dfs and dfs.ended %}
				<span class="stale">last check {{ dfs.took|default(dfs.elapsed) }}s of {{ dfs.expected }},
					{{ dfs.outcome }}{% if dfs.age is not null %}, {{ (dfs.age / 60)|round }} min ago{% endif %}</span>
			{% else %}
				<span class="stale">not listening{% if dfs_expect %}; this radio would need
					{{ dfs_expect }}s on this channel, which is the deadline a timeout is measured
					against{% endif %}</span>
			{% endif %}
		</div>
		{% endif %}
		{% if running.beacon_interval is defined %}
		<div class="stat">
			<b>{{ running.beacon_interval }}</b>
			<span>beacon interval · {{ running.phy|default('') }}</span>
			<span class="stale">{{ (running.beacon_interval * 1.024)|round }} ms between beacons</span>
		</div>
		{% endif %}
	</div>
	{% if running.disagree is defined %}
		<p class="small warn">The bsses on this radio report different values for
		{{ running.disagree|keys|join(', ') }} — they share one radio, so they should not.</p>
	{% endif %}

	{% if running_radio %}
		{% set watch = {'mbssid': 'one beacon set for the whole group', 'rnr': 'advertises the other bands',
			'he_bss_color': 'chosen by hostapd', 'he_bss_color_enabled': 'the gate on the colour block',
			'he_spr_psr_enabled': 'spatial reuse', 'he_spr_non_srg_obss_pd_max_offset': 'obss-pd threshold',
			'he_spr_sr_control': 'ored onto by ucode', 'rssi_ignore_probe_request': 'probes below this are ignored',
			'rssi_reject_assoc_rssi': 'associations below this are refused', 'ieee80211ax': 'mbssid needs this',
			'ieee80211be': 'mbssid needs this or ax'} %}
		<h4 class="small" style="margin:1em 0 .2em">What these options became on the device</h4>
		<table class="counters small">
			<tr><th>option</th><th>running</th><th></th></tr>
			{% for name, why in watch %}
				{% if running_radio[name] is defined %}
					<tr>
						<td class="mono">{{ name }}</td>
						<td><b>{{ running_radio[name] }}</b></td>
						<td class="stale">{{ why }}</td>
					</tr>
				{% endif %}
			{% endfor %}
		</table>
		<p class="small stale">
			Read out of the configuration the access point is running, as the consistency check last
			fetched it — so it changes at a provisioning run, not while you type. An option you set
			that is missing here did not arrive.
		</p>
	{% endif %}

	<table class="counters small">
		<tr><th>bss</th><th>bssid</th><th>state</th><th title="neighbour reports sent">rrm nr_tx</th>
			<th title="bss transition requests we sent">wnm req</th>
			<th title="responses stations sent back">resp</th>
			<th title="stations asking where else to go">query</th></tr>
		{% for b in bss %}
		<tr>
			<td>{{ b.ssid ?: b.name }}<div class="stale">{{ b.ifname ?: '(no name)' }}</div></td>
			<td class="mono">{{ b.status.bssid|default('—') }}</td>
			<td>{{ b.status.status|default(b.state) }}</td>
			<td>{{ b.status.rrm.neighbor_report_tx|default('—') }}</td>
			<td>{{ b.status.wnm.bss_transition_request_tx|default('—') }}</td>
			<td>{{ b.status.wnm.bss_transition_response_rx|default('—') }}</td>
			<td>{{ b.status.wnm.bss_transition_query_rx|default('—') }}</td>
		</tr>
		{% endfor %}
	</table>
	<p class="small stale">
		Read from the last status cycle, not fetched now. The counters are hostapd's own and
		reset when a bss restarts, so they count since the last provisioning run rather than
		since forever.
	</p>
</div>
{% endif %}

{% if plan %}
<div class="card">
	<h3 class="small" style="margin:0 0 .3em">What this radio may use, and what is already on it</h3>
	<p class="small stale">
		Asked of {{ plan.ifname }} ({{ plan.phy ?: 'phy?' }}) in country {{ plan.country ?: '?' }},
		{{ plan.channels|length }} channels.
		A width is offered only where every channel of its block exists on this radio and the
		regulation covering the block allows it. The number in a cell is how busy the whole block
		is — an 80 MHz channel inherits the interference of all four channels it is made of, so a
		quiet primary next to three crowded neighbours is worth seeing.
		{% if plan.own_airtime is not null %}This radio is itself putting {{ plan.own_airtime }}% on the air.{% endif %}
		<a href="{{ path('radio_detail', {'id': radio.id, 'refresh': 1}) }}">ask again</a>
	</p>
	<div class="planwrap">
	<table class="plan">
		<tr>
			<th></th>
			{% for ch, c in plan.channels %}
				<th class="{{ c.active ? 'now' : '' }}" title="{{ c.mhz }} MHz{% if c.dfs %}, radar detection{% endif %}{% if c.indoor %}, indoor only{% endif %}{% if c.no_ir %}, may not transmit{% endif %}">
					{{ ch }}
					<div class="marks">{% if c.dfs %}<span title="radar detection — up to ten minutes of listening before it may be used">d</span>{% endif %}{% if c.indoor %}<span title="indoor only">i</span>{% endif %}</div>
				</th>
			{% endfor %}
		</tr>
		<tr class="load">
			<th class="w">busy</th>
			{% for ch, c in plan.channels %}
				<td title="{% if c.busy_pct is not null %}{{ c.busy_pct }}% of {{ c.measured_ms }} ms measured{% else %}not measured{% endif %}">{{ c.busy_pct is not null ? c.busy_pct|round : '·' }}</td>
			{% endfor %}
		</tr>
		<tr class="load">
			<th class="w">networks</th>
			{% for ch, c in plan.channels %}
				<td title="{% if c.bss %}{{ c.bss }} other networks, strongest {{ c.strongest }} dBm{% else %}none seen{% if plan.scan_age is null %} — no scan has been made{% endif %}{% endif %}">{{ c.bss ?: '·' }}</td>
			{% endfor %}
		</tr>
		<tr class="load">
			<th class="w">noise</th>
			{% for ch, c in plan.channels %}
				<td>{{ c.noise is not null ? c.noise : '·' }}</td>
			{% endfor %}
		</tr>
		{% for w, r in plan.widths %}
			<tr>
				<th class="w">{{ w }} MHz</th>
				{% for ch, c in plan.channels %}
					{% if ch in r.ok %}
						{% set b = plan.blocks[w][ch]|default(null) %}
						{% set busy = b ? b.busy_pct : null %}
						<td class="ok{{ c.active ? ' now' : '' }}{% if busy is not null %}{{ busy >= 50 ? ' hot' : (busy >= 20 ? ' warm' : '') }}{% endif %}"
						    data-ch="{{ ch }}" data-w="{{ w }}"
						    title="channel {{ ch }} at {{ w }} MHz{% if b %} — block {{ b.members|join(', ') }}{% if b.busy_pct is not null %}, busiest {{ b.busy_pct }}%{% endif %}{% if b.bss %}, {{ b.bss }} other networks{% endif %}{% endif %}">{{ busy is not null ? busy|round : '✓' }}</td>
					{% else %}
						<td class="no" title="{{ r.no[ch]|default('not possible') }}">·</td>
					{% endif %}
				{% endfor %}
			</tr>
		{% endfor %}
	</table>
	</div>
	<p class="small stale">
		<b>d</b> radar detection — choosing it costs a listening period before the radio may
		transmit, and it may be moved off again later ·
		<b>i</b> indoor only ·
		the highlighted column is the channel in use ·
		hover a <b>·</b> for the reason, a number for the block it stands for ·
		busy and noise come from the radio's own survey, the network count from the last neighbour
		scan{% if plan.scan_age is not null %} ({{ (plan.scan_age / 3600)|round }} h ago){% else %}, which has never run for this radio{% endif %}
	</p>
</div>
{% endif %}

{% if probes or ctrlcounts %}
<div class="card">
	{% if probes %}
		<h3 class="small" style="margin:0 0 .3em">What this radio hears, and what a threshold would cost</h3>
		<p class="small stale">
			{{ probes.stations }} stations, one entry each at its <b>strongest</b> — a threshold above
			that is a station turned away for good rather than now and then. Strongest
			{{ probes.max }}, median {{ probes.median }}, weakest {{ probes.min }} dBm.
			From the probe requests of the last week.
		</p>
		<table class="hist small">
			{% for edge, n in probes.bins|reverse(true) %}
				<tr>
					<th>{{ edge }}…{{ edge + 4 }}</th>
					<td class="bar"><span style="width: {{ probes.peak ? (n * 100 / probes.peak)|round : 0 }}%">&nbsp;</span></td>
					<td class="n">{{ n ?: '' }}</td>
				</tr>
			{% endfor %}
		</table>
		<p class="small">
			<b>rssi_ignore_probe_request</b> and <b>rssi_reject_assoc_rssi</b> take one of these:
		</p>
		<table class="thresh small">
			<tr><th>threshold</th>{% for t, r in probes.thresholds %}<th>{{ t }}</th>{% endfor %}</tr>
			<tr><th>would keep</th>{% for t, r in probes.thresholds %}<td>{{ r.kept }}</td>{% endfor %}</tr>
			<tr><th>would turn away</th>{% for t, r in probes.thresholds %}
				<td class="{{ r.turned_away ? 'warn' : '' }}">{{ r.turned_away }}</td>{% endfor %}</tr>
		</table>
		<p class="small stale">
			A station turned away is not told why — it simply cannot connect. Start below what you
			think the edge is, and read this again a week later.
		</p>
	{% endif %}

	{% if ctrlcounts %}
		<h3 class="small" style="margin:1em 0 .3em">What the bsses on this radio have reported</h3>
		<table class="counters small">
			<tr><th>event</th><th>count</th><th title="events per hour since the first one">per hour</th>
				<th title="what handling one costs the subscriber loop">avg</th>
				<th title="the slowest one seen">worst</th>
				<th>last</th><th>since</th></tr>
			{% for name, c in ctrlcounts %}
				<tr>
					<td class="mono">{{ name }}</td>
					<td>{{ c.n }}</td>
					<td>{{ c.rate is not null ? c.rate : '—' }}</td>
					<td>{{ c.ms_avg is not null ? c.ms_avg|round(2) ~ ' ms' : '—' }}</td>
					<td class="{{ c.ms_max > 50 ? 'warn' : '' }}">{{ c.ms_max ? c.ms_max|round(2) ~ ' ms' : '—' }}</td>
					<td>{{ c.last ? (c.last|date('Y-m-d H:i')) : '—' }}</td>
					<td class="stale">{{ c.first ? (c.first|date('Y-m-d H:i')) : '—' }}</td>
				</tr>
			{% endfor %}
		</table>
		<p class="small stale">
			Counted for a week, per name, from hostapd's own control channel, with what each one
			costs the subscriber loop — the same three numbers the RADIUS page reports for an
			answer, and the ones that say whether forwarding the whole socket stream is
			affordable. Every name is counted rather than a chosen few, so an event nobody
			thought of appears here by itself —
			<span class="mono">OCV-FAILURE</span> will show up the day <span class="mono">ocv</span>
			is switched on. There is no access point side event for beacon protection in this
			hostapd build, so that one cannot be counted at all.
		</p>
	{% endif %}
</div>
{% endif %}

{% if hints %}
<div class="card warn-card">
	<p class="small"><b>Worth knowing about what is set here</b></p>
	<ul class="small">{% for h in hints %}<li>{{ h }}</li>{% endfor %}</ul>
</div>
{% endif %}

<form id="editor" method="post" action="{{ path('radio_save', {'id': radio.id}) }}">
	<div class="toolbar">
		<input type="search" id="filter" placeholder="filter by name or description…">
		<label class="small">show
			<select id="scope">
				<option value="documented">set and documented defaults</option>
				<option value="all">everything, including inactive functions</option>
				<option value="set">only what is set</option>
			</select>
		</label>
		<button type="button" id="toggleall" class="ghost small">close all</button>
		<span id="shown" class="small stale"></span>
		<span class="spacer"></span>
		<button type="submit">Save</button>
		<span id="result" class="small"></span>
	</div>

	<p class="small legend">
		<span class="tag set">set</span> stored here and written to the access point ·
		<span class="tag def">default</span> not stored, the shown OpenWrt default applies ·
		<span class="tag off">off</span> a switch that is not written, so the function is off ·
		<span class="tag un">not written</span> hostapd's own built-in value applies, which the schema does not state
	</p>

	{{ include('default/_option_groups.html.twig') }}
</form>
{% endblock %}

{% block javascripts %}
{{ include('default/_option_filter.html.twig', {'storage_key': 'apman.radio.scope'}) }}
<script>
// Clicking a cell fills in the two fields it takes to mean it. The width is a
// number inside a name — HE80, VHT40 — so the prefix already in the field is
// kept and only the number replaced; a radio configured for VHT stays VHT.
document.querySelectorAll('table.plan td.ok').forEach(function (cell) {
	cell.addEventListener('click', function () {
		var ch = document.querySelector('[name="opt[channel]"]');
		var hm = document.querySelector('[name="opt[htmode]"]');
		if (ch) { ch.value = cell.dataset.ch; ch.dispatchEvent(new Event('change', {bubbles: true})); }
		if (hm) {
			var prefix = (hm.value.match(/^[A-Za-z]+/) || ['HE'])[0].toUpperCase();
			if (prefix === 'NOHT' || prefix === '') { prefix = 'HE'; }
			hm.value = prefix + cell.dataset.w;
			hm.dispatchEvent(new Event('change', {bubbles: true}));
		}
		document.querySelectorAll('table.plan td.picked').forEach(function (c) { c.classList.remove('picked'); });
		cell.classList.add('picked');
		var res = document.getElementById('result');
		if (res) { res.textContent = 'channel ' + cell.dataset.ch + ' at ' + cell.dataset.w + ' MHz — not saved yet'; }
		if (ch) { ch.scrollIntoView({block: 'center', behavior: 'smooth'}); }
	});
});
</script>
{% endblock %}

{% block stylesheets %}
{{ include('default/_option_styles.html.twig') }}
<style>
	.stats { display: flex; flex-wrap: wrap; gap: 1.2em 2em; }
	.stat { min-width: 8em; max-width: 22em; }
	.stat b { display: block; font-size: 1.6em; line-height: 1.1; }
	.stat span { display: block; font-size: .8em; }
	.stat span + span { color: var(--ink-mute); }
	.stat.warn b, .stat span.warn { color: var(--warn-strong); }
	.stat.bad b { color: var(--bad); }
	.cacbar { display: block; height: .35em; background: var(--bar-bg); border-radius: 2px;
	          overflow: hidden; margin-top: .3em; max-width: 14em; }
	.cacbar > span { display: block; height: 100%; background: var(--bar-weak); }
	.cacbar.over > span { background: var(--bar-bad); }

	table.counters { border-collapse: collapse; margin-top: 1em; }
	table.counters th, table.counters td { padding: .25em .8em .25em 0; text-align: left;
	                                       vertical-align: top; }
	table.counters th { border-bottom: 1px solid var(--line-strong); font-weight: 600; }
	table.counters .stale { color: var(--ink-mute); font-style: normal; }

	.planwrap { overflow-x: auto; }
	table.plan { border-collapse: collapse; font-size: .8em; }
	table.plan th, table.plan td { border: 1px solid #e4e4e4; padding: .15em .35em; text-align: center; }
	table.plan th.w { text-align: right; white-space: nowrap; font-weight: 600; }
	table.plan th .marks { color: var(--warn-strong); font-size: .8em; line-height: 1; }
	table.plan th.now, table.plan td.ok.now { background: var(--accent-bg); }
	table.plan td.ok { color: var(--good); cursor: pointer; }
	table.plan td.ok:hover { background: var(--good-bg); }
	table.plan td.no { color: var(--line-strong); cursor: help; }
	table.plan td.ok.warm { background: var(--warn-bg); color: var(--warn); }
	table.plan td.ok.hot { background: var(--bad-bg); color: var(--bad); }
	table.plan tr.load td { color: var(--ink-mute); background: var(--bg-sunken); font-size: .95em; }
	table.plan tr.load th.w { color: var(--ink-mute); font-weight: 400; }
	table.plan td.picked { background: var(--good); color: #fff; }

	table.hist { border-collapse: collapse; margin: .5em 0; }
	table.hist th { text-align: right; padding: .05em .6em .05em 0; font-weight: 400; white-space: nowrap; }
	table.hist td.bar { width: 18em; height: auto; background: none; border-radius: 0; display: table-cell; }
	table.hist td.bar span { display: block; background: var(--bar-plain); height: .9em; min-width: 0; }
	table.hist td.n { padding-left: .6em; }

	table.thresh { border-collapse: collapse; margin: .3em 0 .5em; }
	table.thresh th, table.thresh td { padding: .2em .9em .2em 0; text-align: left; }
	table.thresh th { font-weight: 600; }
	table.thresh td.warn { color: var(--warn-strong); font-weight: 600; }
</style>
{% endblock %}
