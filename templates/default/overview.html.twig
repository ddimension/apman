{% extends 'frontend.html.twig' %}
{% block title %}Overview{% endblock %}

{% block body %}
<div class="card" id="fleethistory">
	<h3 class="small" style="margin:0 0 .3em">
		The fleet over time
		<span class="small stale">
			{% for sp in fleet_spans %}<a href="{{ path('overview', {'span': sp}) }}"
				class="{{ sp == fleet_span ? 'active-span' : '' }}">{{ sp }}</a>{{ not loop.last ? ' · ' }}{% endfor %}
		</span>
	</h3>
	{% if fleet_history|length < 2 %}
		<p class="small stale">
			{{ fleet_history|length }} column{{ fleet_history|length == 1 ? '' : 's' }} so far. The
			series is written every five minutes by <span class="mono">apman:sample</span> and there
			is none from before it was first switched on.
		</p>
	{% else %}
		<svg id="fbusy" viewBox="0 0 900 120" preserveAspectRatio="none" aria-label="how busy the bands were"></svg>
		<p class="small stale" id="fbusykey" style="margin:.2em 0 .8em"></p>
		<svg id="fsta" viewBox="0 0 900 90" preserveAspectRatio="none" aria-label="stations"></svg>
		<p class="small stale" style="margin:.2em 0 0">
			<b class="k-sta">stations associated across the fleet</b> · <b class="k-rx">received</b>
			· <b class="k-tx">sent</b>, added up over every radio. The busy figures above are averages
			of the radios on that band that answered, because a radio that was away for one run should
			not read as a quiet one.
		</p>
	{% endif %}
</div>

<h2>Overview</h2>

{# Events the access points logged and then lost. A firmware fault erases its
   own evidence by rebooting into an empty ring buffer, and a radar hit is
   interesting weeks later, when somebody asks why a radio is not on the
   channel it was configured for. Only shown when there is something. #}
{% if syslog_events.total %}
<div class="card">
	<h3 class="small">From the logs{% if syslog_events.bad %}
		<span class="pill down">{{ syslog_events.bad }} to look at</span>{% endif %}</h3>
	<p class="small stale">
		{% for key, n in syslog_events.counts %}{{ n }}× {{ key|replace({'_': ' '}) }}{{ not loop.last ? ' · ' }}{% endfor %}
		— kept for 30 days, which is longer than any access point keeps its own log.
	</p>
	<table class="small">
		{% for e in syslog_events.recent %}
			<tr>
				<td class="stale">{{ e.ts|date('d.m. H:i') }}</td>
				<td><a href="{{ path('ap_detail', {'name': e.ap}) }}">{{ e.ap }}</a></td>
				<td class="{{ e.bad ? 'warn' : 'ok' }}">{{ e.label }}</td>
				<td class="stale">{{ e.text|slice(0, 90) }}</td>
			</tr>
		{% endfor %}
	</table>
	<p class="small stale">The reboot on a firmware fault stays on the access point,
		where it still works when the controller or the broker is the thing that is broken.</p>
</div>
{% endif %}

<div class="cards">
	<div class="card big">
		<h3 class="small">Access points</h3>
		<div class="stats">
			{% for state, n in tree.ap %}
				<div class="stat"><b class="{{ state in ['ACTIVE','ONLINE'] ? 'ok' : 'warn' }}">{{ n }}</b>
					<span>{{ state|lower }}</span></div>
			{% endfor %}
		</div>
		<p class="small stale">radios: {% for s, n in tree.radio %}{{ n }} {{ s|lower }}{{ not loop.last ? ' · ' }}{% endfor %}</p>
		<p class="small stale">bss: {% for s, n in tree.bss %}{{ n }} {{ s|lower }}{{ not loop.last ? ' · ' }}{% endfor %}</p>
		<p class="small"><a href="{{ path('aps') }}">the fleet</a></p>
	</div>

	<div class="card big">
		<h3 class="small">Audit</h3>
		<div class="stats">
			<div class="stat"><b class="{{ findings|length ? 'warn' : 'ok' }}">{{ findings|length }}</b>
				<span>finding{{ findings|length == 1 ? '' : 's' }}</span>
				<span class="stale">{% if audit_age is not null %}checked {{ (audit_age / 60)|round }} min ago{% else %}never checked{% endif %}</span></div>
		</div>
		{% if findings|length %}
			<ul class="small">
				{% for f in findings|slice(0, 5) %}
					<li><b>{{ f.option }}</b> <span class="stale">{{ f.group }}</span></li>
				{% endfor %}
			</ul>
		{% else %}
			<p class="small stale">Nothing set that does not arrive, nothing running that we did not
				ask for, no two bsses sharing an address or a name.</p>
		{% endif %}
		<p class="small"><a href="{{ path('consistency') }}">what was compared</a></p>
	</div>

	<div class="card big">
		<h3 class="small">Waiting to be rolled out</h3>
		<div class="stats">
			<div class="stat"><b class="{{ open_total ? 'warn' : 'ok' }}">{{ open_total }}</b>
				<span>network{{ open_total == 1 ? '' : 's' }} with an open radio</span>
				<span class="stale">neither carried nor deliberately left out</span></div>
		</div>
		{% if open %}
			<ul class="small">
				{% for o in open %}
					<li><a href="{{ path('ssid_rollout', {'id': o.id}) }}">{{ o.ssid }}</a>
						<span class="stale">{{ o.radios }} radio{{ o.radios == 1 ? '' : 's' }}</span></li>
				{% endfor %}
			</ul>
		{% endif %}
		<p class="small"><a href="{{ path('rollout_matrix') }}">the whole matrix</a></p>
	</div>
</div>

<div class="cards">
	<div class="card big">
		<h3 class="small">Stations</h3>
		<div class="stats">
			<div class="stat"><b>{{ stations }}</b><span>on the air now</span></div>
			{% for band, n in by_band %}
				<div class="stat"><b>{{ n }}</b><span>{{ band }}</span></div>
			{% endfor %}
		</div>
		{% if per_ap %}
			<table class="counters small">
				{% for name, n in per_ap %}
					<tr><td><a href="{{ path('ap_detail', {'name': name}) }}">{{ name }}</a></td>
						<td>{{ n }}</td></tr>
				{% endfor %}
			</table>
		{% endif %}
		<p class="small"><a href="{{ path('apman_default_index') }}">every station</a></p>
	</div>

	<div class="card big">
		<h3 class="small">Busiest radios</h3>
		{% if busiest %}
			<table class="counters small">
				{% for b in busiest %}
					<tr>
						<td><a href="{{ path('radio_detail', {'id': b.id}) }}">{{ b.ap }}/{{ b.radio }}</a></td>
						<td class="stale">{{ b.band }}{% if b.channel %} ch {{ b.channel }}{% endif %}</td>
						<td><span class="bar {{ b.pct > 60 ? 'bad' : (b.pct > 30 ? 'weak' : '') }}"><span
							style="width: {{ b.pct }}%"></span></span> {{ b.pct }}%</td>
					</tr>
				{% endfor %}
			</table>
			<p class="small stale">Airtime the radio reports as in use — shared by every bss on it.</p>
		{% else %}
			<p class="small stale">No radio has reported its airtime yet.</p>
		{% endif %}
		<p class="small"><a href="{{ path('aps') }}">the channel map</a></p>
	</div>

	<div class="card big">
		<h3 class="small">Who got let in</h3>
		{% if radius and radius.n %}
			<div class="stats">
				<div class="stat"><b>{{ radius.n }}</b><span>requests, 24 h</span></div>
				<div class="stat"><b class="{{ radius.bad > 0 ? 'warn' : 'ok' }}">{{ radius.bad ?: 0 }}</b>
					<span>turned away</span></div>
				<div class="stat"><b>{{ radius.ms ?: '—' }}</b><span>ms average</span>
					<span class="stale">worst {{ radius.msmax ?: '—' }} ms</span></div>
			</div>
			<p class="small stale">Answered on the access point itself, out of the key store this
				controller distributes.</p>
		{% else %}
			<p class="small stale">Nothing asked in the last day.</p>
		{% endif %}
		{% if keys and keys.n %}
			<p class="small">
				<b>{{ keys.n }}</b> keys, {{ keys.used ?: 0 }} ever used,
				<span class="{{ (keys.n - (keys.used ?: 0)) > 0 ? 'warn' : '' }}">{{ keys.n - (keys.used ?: 0) }}</span>
				never — a key handed out and never seen is a device nobody set up, or one that
				cannot get on.
			</p>
		{% endif %}
		<p class="small"><a href="{{ path('radius') }}">what was asked</a> ·
			<a href="{{ path('ipsk') }}">the keys</a></p>
	</div>
</div>

<div class="cards">
	<div class="card big">
		<h3 class="small">What hostapd has been saying</h3>
		{% if ctrl %}
			<table class="counters small">
				<tr><th>event</th><th>n</th><th>per hour</th><th>avg</th></tr>
				{% for name, c in ctrl %}
					<tr><td class="mono">{{ name }}</td><td>{{ c.n }}</td>
						<td>{{ c.rate is not null ? c.rate : '—' }}</td>
						<td class="stale">{{ c.ms_avg is not null ? c.ms_avg|round(2) ~ ' ms' : '—' }}</td></tr>
				{% endfor %}
			</table>
			<p class="small stale">Counted per bss for a week, with what handling one costs the
				subscriber loop.</p>
		{% else %}
			<p class="small stale">Nothing counted yet.</p>
		{% endif %}
	</div>

	<div class="card big">
		<h3 class="small">Steering</h3>
		{% if steering.total %}
			<div class="stats">
				<div class="stat"><b>{{ steering.total }}</b><span>answers, 24 h</span></div>
				<div class="stat"><b class="ok">{{ steering.accepted }}</b><span>moved</span></div>
				<div class="stat"><b class="{{ steering.rejected ? 'warn' : '' }}">{{ steering.rejected }}</b>
					<span>refused</span></div>
			</div>
			<p class="small stale">A station that answers status 0 went where it was asked. One that
				refuses is either busy or does not do 802.11v.</p>
		{% else %}
			<p class="small stale">No station has been asked to move in the last day.</p>
		{% endif %}
	</div>

	{% if busiest_clients|length %}
	<div class="card big">
		<h3 class="small">Who used it <span class="small stale">last 7 days</span></h3>
		<table class="counters small">
			<tr><th>client</th><th>up</th><th>down</th><th>together</th><th>seen</th></tr>
			{% for c in busiest_clients %}
				<tr>
					<td><a href="{{ path('client_detail', {'mac': c.mac}) }}" class="mono">{{ c.mac }}</a></td>
					<td class="mono stale">{{ (c.rx / 1048576)|round(1) }} MiB</td>
					<td class="mono stale">{{ (c.tx / 1048576)|round(1) }} MiB</td>
					<td class="mono"><b>{{ c.total > 1073741824
						? (c.total / 1073741824)|round(1) ~ ' GiB'
						: (c.total / 1048576)|round(1) ~ ' MiB' }}</b></td>
					<td class="stale">{{ (c.seen / 3600)|round(1) }} h</td>
				</tr>
			{% endfor %}
		</table>
		<p class="small stale">Up is what the station sent and down is what it was given, from the
			access point's side. Counted from the interface counters every five minutes, so a station
			that was on for two of them is accounted to five minutes and no better.</p>
	</div>
	{% endif %}

	{% if blocked|length %}
	<div class="card big">
		<h3 class="small">Kept off</h3>
		<table class="counters small">
			{% for c in blocked %}
				<tr>
					<td><a href="{{ path('client_detail', {'mac': c.mac}) }}" class="mono">{{ c.name ?: c.mac }}</a></td>
					<td class="{{ c.isBlocked ? 'warn' : 'stale' }}">
						{% if c.isBlocked %}until {{ c.blockedUntil|date('d.m. H:i') }}
						{% else %}lapsed {{ c.blockedUntil|date('d.m. H:i') }}{% endif %}</td>
					<td class="stale">{{ c.blockedReason ?: '' }}</td>
				</tr>
			{% endfor %}
		</table>
		<p class="small stale">A blocked station is thrown off wherever it appears, so it gets on for a
			moment each time before it is turned away. One whose block has lapsed is welcome again and
			is only still listed because the reason is worth keeping.</p>
	</div>
	{% endif %}

	{% if airtime|length %}
	<div class="card big">
		<h3 class="small">Share of the medium</h3>
		<table class="counters small">
			<tr><th>client</th><th>asked</th><th>running</th><th></th></tr>
			{% for row in airtime %}
				<tr>
					<td><a href="{{ path('client_detail', {'mac': row.mac}) }}" class="mono">{{ row.name ?: row.mac }}</a>
						{% if row.where %}<div class="stale">{{ row.where }}</div>{% endif %}</td>
					<td class="mono">{{ row.want }}</td>
					<td class="mono {{ row.running and row.running != row.want ? 'warn' : '' }}">{{ row.running ?: '—' }}</td>
					<td class="{{ row.policy and not row.policy.ok ? 'warn' : 'stale' }}">
						{% if not row.where %}not associated anywhere
						{% elseif row.policy and not row.policy.ok %}this radio ignores weights
						{% elseif row.running == row.want %}in effect
						{% else %}not applied yet{% endif %}</td>
				</tr>
			{% endfor %}
		</table>
		<p class="small stale">{{ airtime_default }} is a normal station. The weight lives in the driver
			and dies with the association, so it is put back every time the station connects.</p>
	</div>
	{% endif %}

	<div class="card big">
		<h3 class="small">Agents</h3>
		<table class="counters small">
			{% for version, names in agents %}
				<tr>
					<td><b>{{ version }}</b></td>
					<td>{{ names|length }}</td>
					<td class="stale">{{ names|join(', ') }}</td>
				</tr>
			{% endfor %}
		</table>
		{% set known = agents|keys|filter(v => v != 'unknown')|length %}
		{% if known > 1 %}
			<p class="small warn">More than one version in the fleet — a measurement on one access
				point then says nothing certain about the others.</p>
		{% elseif agents['unknown'] is defined %}
			<p class="small stale">One version among the access points that answer.
				{{ agents['unknown']|length }} has not said which it runs, which is what an access
				point that is not reachable looks like.</p>
		{% else %}
			<p class="small stale">One version everywhere, which is what makes a measurement on one
				access point mean something about the others.</p>
		{% endif %}
	</div>
</div>

{% if trouble or listening or drift %}
<div class="card">
	<h3 class="small" style="margin:0 0 .4em">What is not as it should be</h3>
	<table class="counters small">
		{% for t in trouble %}
			<tr><td><span class="pill down">{{ t.state }}</span></td>
				<td><a href="{{ t.link }}">{{ t.what }}</a></td>
				<td class="stale">the access point is not carrying traffic</td></tr>
		{% endfor %}
		{% for l in listening %}
			<tr><td><span class="pill {{ l.overdue ? 'down' : '' }}">CAC</span></td>
				<td><a href="{{ path('radio_detail', {'id': l.id}) }}">{{ l.ap }}/{{ l.radio }}</a></td>
				<td class="stale">listening for {{ l.elapsed }}s of {{ l.expected }} expected{% if l.overdue %} —
					<span class="warn">past its deadline</span>{% endif %}</td></tr>
		{% endfor %}
		{% for d in drift %}
			<tr><td><span class="pill">channel</span></td>
				<td><a href="{{ path('radio_detail', {'id': d.id}) }}">{{ d.ap }}/{{ d.radio }}</a></td>
				<td class="stale">configured {{ d.wanted }}, running {{ d.running }} — usually dfs moved it</td></tr>
		{% endfor %}
	</table>
</div>
{% else %}
<div class="card">
	<p class="small ok">Every productive access point is carrying traffic, no radio is listening,
		and none is on a channel other than the one it was given.</p>
</div>
{% endif %}

<p class="small stale">
	Everything here is computed for some other page; this only puts the numbers in one place. The
	audit is read from its cache and not fetched — <a href="{{ path('consistency') }}?refresh=1">run it now</a>
	if you want it fresh.
</p>
{% endblock %}

{% block javascripts %}
<script>
// The same two ideas as the radio page's chart: a path per line, and a gap
// wherever there is no honest number. Nothing is fetched; the series comes over
// with the page.
(function () {
	var F = {{ fleet_history|json_encode|raw }};
	if (F.length < 2) { return; }
	var W = 900, PAD = 4;
	var t0 = F[0].ts, span = Math.max(1, F[F.length - 1].ts - t0);
	function x(ts) { return PAD + (W - 2 * PAD) * (ts - t0) / span; }

	function paths(H, get, top, ht, cls, fill) {
		var runs = [], cur = [], out = '';
		H.forEach(function (p) {
			var v = get(p);
			if (v === null || v === undefined) { if (cur.length) { runs.push(cur); cur = []; } return; }
			cur.push([x(p.ts), ht - PAD - (ht - 2 * PAD) * v / top]);
		});
		if (cur.length) { runs.push(cur); }
		runs.forEach(function (run) {
			if (run.length < 2) { return; }
			var d = 'M' + run.map(function (q) { return q[0].toFixed(1) + ',' + q[1].toFixed(1); }).join('L');
			if (fill) {
				out += '<path d="' + d + 'L' + run[run.length - 1][0].toFixed(1) + ',' + (ht - PAD)
					+ 'L' + run[0][0].toFixed(1) + ',' + (ht - PAD) + 'Z" class="' + cls + ' area"/>';
			}
			out += '<path d="' + d + '" class="' + cls + '" fill="none"/>';
		});
		return out;
	}

	// one line per band, in the order the bands happen to appear
	var bands = [];
	F.forEach(function (p) {
		Object.keys(p.busy || {}).forEach(function (b) { if (bands.indexOf(b) < 0) { bands.push(b); } });
	});
	bands.sort();
	var palette = ['k-b1', 'k-b2', 'k-b3', 'k-b4'];
	var HT = 120, out = '';
	out += '<line x1="0" y1="' + (HT - PAD - (HT - 2 * PAD)) + '" x2="' + W + '" y2="'
		+ (HT - PAD - (HT - 2 * PAD)) + '" class="axis"/>';
	out += '<text x="2" y="' + (HT - PAD - (HT - 2 * PAD) + 9) + '" class="axislabel">100 %</text>';
	bands.forEach(function (b, i) {
		out += paths(F, function (p) { return (p.busy && p.busy[b] !== undefined) ? p.busy[b] : null; },
			100, HT, palette[i % palette.length], i === 0);
	});
	document.getElementById('fbusy').innerHTML = out;
	document.getElementById('fbusykey').innerHTML = bands.map(function (b, i) {
		return '<b class="' + palette[i % palette.length] + '">' + b + '</b>';
	}).join(' · ') + ' — how much of the channel was in use, measured from the radios\u2019 own airtime counters';

	var topSta = 1, topRate = 1;
	F.forEach(function (p) {
		if (p.stations > topSta) { topSta = p.stations; }
		if (p.rx_bps > topRate) { topRate = p.rx_bps; }
		if (p.tx_bps > topRate) { topRate = p.tx_bps; }
	});
	var HS = 90, o2 = '';
	o2 += paths(F, function (p) { return p.rx_bps; }, topRate, HS, 'k-rx');
	o2 += paths(F, function (p) { return p.tx_bps; }, topRate, HS, 'k-tx');
	o2 += paths(F, function (p) { return p.stations; }, topSta, HS, 'k-sta');
	o2 += '<text x="2" y="12" class="axislabel k-sta">' + topSta + ' stations</text>';
	o2 += '<text x="' + (W - 90) + '" y="12" class="axislabel k-rx">'
		+ (topRate >= 1e6 ? (topRate / 1e6).toFixed(0) + ' Mbit/s' : (topRate / 1e3).toFixed(0) + ' kbit/s') + '</text>';
	document.getElementById('fsta').innerHTML = o2;
})();
</script>
{% endblock %}

{% block stylesheets %}
<style>
.cards { display: flex; flex-wrap: wrap; gap: 1rem; }
.card.big { flex: 1 1 20rem; min-width: 18rem; }
.card.big h3 { margin: 0 0 .4em; }
.card.big ul { margin: .3em 0 .4em 1.1em; padding: 0; }
.stats { display: flex; flex-wrap: wrap; gap: 1rem 1.6rem; }
.stat { min-width: 5em; }
.stat b { display: block; font-size: 1.8em; line-height: 1.1; }
.stat span { display: block; font-size: .8em; }
.stat span + span { color: var(--ink-mute); }
table.counters { border-collapse: collapse; }
table.counters td, table.counters th { padding: .2em .8em .2em 0; vertical-align: top; text-align: left; }
table.counters th { font-weight: 600; }
.mono { font-family: var(--mono); }
	#fleethistory svg { width: 100%; display: block; }
	#fleethistory #fbusy { height: 120px; }
	#fleethistory #fsta { height: 90px; }
	#fleethistory .axis { stroke: var(--line-soft); stroke-width: 1; }
	#fleethistory .axislabel { font-size: 9px; fill: var(--ink-mute); }
	#fleethistory .active-span { font-weight: 700; text-decoration: none; }
	.k-b1 { stroke: #3b7dd8; stroke-width: 1.5; }
	.k-b1.area { fill: #3b7dd8; fill-opacity: .14; stroke: none; }
	.k-b2 { stroke: #d8823b; stroke-width: 1.5; }
	.k-b3 { stroke: #4fa86a; stroke-width: 1.5; }
	.k-b4 { stroke: #9b59b6; stroke-width: 1.5; }
	#fleethistory b.k-b1 { color: #3b7dd8; }
	#fleethistory b.k-b2 { color: #d8823b; }
	#fleethistory b.k-b3 { color: #4fa86a; }
	#fleethistory b.k-b4 { color: #9b59b6; }
	#fleethistory b.k-sta { color: var(--warn-strong); }
	#fleethistory b.k-rx { color: var(--good); }
	#fleethistory b.k-tx { color: #3b7dd8; }
	#fleethistory .k-sta { stroke: var(--warn-strong); stroke-width: 1.5; }
	#fleethistory .k-rx { stroke: var(--good); stroke-width: 1.5; }
	#fleethistory .k-tx { stroke: #3b7dd8; stroke-width: 1.5; }
</style>
{% endblock %}
