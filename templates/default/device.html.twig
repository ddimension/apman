{% extends 'frontend.html.twig' %}
{% block title %}{{ device.name }}{% endblock %}

{% block body %}
<h2>
	{% if ap %}<a href="{{ path('ap_detail', {'name': ap.name}) }}">{{ ap.name }}</a> /{% endif %}
	{% if radio %}<a href="{{ path('radio_detail', {'id': radio.id}) }}">{{ radio.name }}</a> /{% endif %}
	{{ device.ifname ?: device.name }}
	<span class="small">bss</span>
</h2>

<p class="small">
	One bss on one radio. Its options come from three places and they are kept apart here: what
	{% if ssid %}<a href="{{ path('ssid_detail', {'id': ssid.id}) }}">{{ ssid.name }}</a>{% else %}the network{% endif %}
	says for every bss of it, what this one decides for itself, and what the access point
	generated out of both. The third can differ from the first two, and when it does that is
	worth knowing.
</p>

<div class="card">
	<div class="stats">
		<div class="stat">
			<b>{{ node.state_name }}</b>
			<span>state{% if age is not null %} · heard {{ age }}s ago{% endif %}</span>
			<span class="stale">{{ device.name }}</span>
		</div>
		<div class="stat">
			<b class="mono">{{ ap_status.bssid|default(device.address) ?: '—' }}</b>
			<span>bssid</span>
			<span class="stale">
				{% if device.address and ap_status.bssid is defined and ap_status.bssid|lower != device.address|lower %}
					<span class="warn">configured {{ device.address }} — a station sees the other one</span>
				{% elseif device.address %}configured, and what runs{% else %}
					<span class="warn">no address configured, so the driver picks one</span>{% endif %}
			</span>
		</div>
		{% if ap_status.freq is defined %}
			<div class="stat">
				<b>{{ ap_status.channel|default('?') }}</b>
				<span>channel · {{ ap_status.freq }} MHz</span>
				<span class="stale">{{ ap_status.status|default('') }}</span>
			</div>
		{% endif %}
		{% if ap_status.wnm is defined %}
			<div class="stat">
				<b>{{ ap_status.wnm.bss_transition_request_tx|default(0) }}</b>
				<span>transitions asked for</span>
				<span class="stale">{{ ap_status.wnm.bss_transition_response_rx|default(0) }} answered,
					{{ ap_status.wnm.bss_transition_query_rx|default(0) }} asked by stations</span>
			</div>
		{% endif %}
		{% if ap_status.rrm is defined %}
			<div class="stat">
				<b>{{ ap_status.rrm.neighbor_report_tx|default(0) }}</b>
				<span>neighbour reports sent</span>
				<span class="stale">802.11k</span>
			</div>
		{% endif %}
		<div class="stat">
			<b>{{ clients|length }}</b>
			<span>stations on it</span>
			<span class="stale">{% if survey %}channel {{ survey.channels }} surveyed{% else %}from the association list{% endif %}</span>
		</div>
		{% if ap_status.airtime is defined and ap_status.airtime.utilization is defined %}
			<div class="stat">
				<b>{{ (ap_status.airtime.utilization * 100 / 255)|round }}%</b>
				<span>airtime on this radio</span>
				<span class="stale">shared with every bss on it</span>
			</div>
		{% endif %}
		{% if mib %}
			<div class="stat">
				<b>{{ mib.first|default('—') }}</b>
				<span>{{ mib.label|default('mib') }}</span>
				<span class="stale">{{ mib.note|default('') }}</span>
			</div>
		{% endif %}
	</div>
	<div id="spark" class="spark">
		<svg viewBox="0 0 300 46" preserveAspectRatio="none" aria-label="throughput">
			<path id="sp-tx" fill="var(--bar-good)" fill-opacity=".65"/>
			<path id="sp-rx" fill="var(--bar-plain)" fill-opacity=".65"/>
			<line x1="0" y1="23" x2="300" y2="23" stroke="var(--line-strong)" stroke-width=".5"/>
		</svg>
		<p class="small stale" id="sp-label">
			reading…
		</p>
	</div>

	{% if bss_info %}
		<p class="small stale" style="margin-top:.6em">
			hostapd runs it as
			<span class="mono">{{ bss_info.ssid|default('?') }}</span>,
			wpa {{ bss_info.wpa|default('?') }},
			key management {{ bss_info.wpa_key_mgmt|default('?') }},
			pmf {{ bss_info.ieee80211w|default('?') }},
			mode {{ bss_info.hw_mode|default('?') }}
		</p>
	{% endif %}
</div>

{% if clients|length %}
<div class="card">
	<h3 class="small" style="margin:0 0 .3em">Stations on this bss</h3>
	<table class="counters small">
		<tr><th>station</th><th>identity</th><th>key</th><th>signal</th>
			<th title="what actually went over the link since the last status cycle">rx now</th>
			<th title="what actually went over the link since the last status cycle">tx now</th>
			<th title="the rate the link negotiated">link</th>
			<th title="what the driver thinks the link could carry">est.</th>
			<th>idle</th><th>connected</th></tr>
		{% for mac, c in clients %}
			<tr>
				<td class="mono"><a href="{{ path('client_detail', {'mac': mac}) }}">{{ mac }}</a></td>
				<td>{{ c.identity ?: '—' }}</td>
				<td>{{ c.akm ?: '—' }}</td>
				<td>{{ c.signal is not null ? c.signal ~ ' dBm' : '—' }}
					{% if c.signal_avg is not null and c.signal_avg != c.signal %}
						<div class="stale">ø {{ c.signal_avg }}</div>{% endif %}</td>
				<td class="{{ c.rx_bps ? 'live' : '' }}">{{ c.rx_bps is not null ? (c.rx_bps > 1000000
					? (c.rx_bps / 1000000)|round(1) ~ ' Mbit/s' : (c.rx_bps / 1000)|round ~ ' kbit/s') : '—' }}</td>
				<td class="{{ c.tx_bps ? 'live' : '' }}">{{ c.tx_bps is not null ? (c.tx_bps > 1000000
					? (c.tx_bps / 1000000)|round(1) ~ ' Mbit/s' : (c.tx_bps / 1000)|round ~ ' kbit/s') : '—' }}</td>
				<td class="stale">{{ c.rx_rate ? (c.rx_rate / 1000)|round ~ '/' : '' }}{{ c.tx_rate ? (c.tx_rate / 1000)|round ~ ' M' : '—' }}
					{% if c.mhz %}<div class="stale">{{ c.mhz }} MHz</div>{% endif %}</td>
				<td class="stale">{{ c.thr ? (c.thr / 1000)|round ~ ' M' : '—' }}</td>
				<td class="stale">{{ c.inactive is not null ? (c.inactive / 1000)|round ~ ' s' : '—' }}</td>
				<td class="stale">{{ c.connected ? (c.connected / 3600)|round ~ ' h' : '—' }}</td>
			</tr>
		{% endfor %}
	</table>
	<p class="small stale">
		<b>rx now</b> and <b>tx now</b> are what actually went over the link{% if span %}, measured
		over the {{ span }} seconds between the last two status cycles{% endif %} — the byte
		counters differenced, the way the old status page does it. <b>link</b> is the rate the two
		agreed on and <b>est.</b> what the driver thinks it could carry; a link that negotiated
		866 M and moved 40 kbit/s is a quiet station, not a broken one.
		The identity is the iPSK the station used, where hostapd told us which one — that is what
		turns "a key was handed out" into "the key is in use".
	</p>
</div>
{% endif %}

<div class="card">
	<h3 class="small" style="margin:0 0 .3em">Turned away</h3>
	{% if bans is null %}
		<p class="small stale">The access point did not say who it is keeping out. hostapd holds bans
			in memory and tells nobody unless asked, so this is "could not ask" and not "nobody".</p>
	{% elseif bans|length %}
		<table class="counters small">
			{% for mac in bans %}
				<tr><td class="mono"><a href="{{ path('client_detail', {'mac': mac}) }}">{{ mac }}</a></td>
					<td class="stale">banned here</td></tr>
			{% endfor %}
		</table>
		<p class="small stale">A ban lasts {{ ban_seconds }} seconds and is renewed whenever the station
			gets in again, so a station that is blocked stays on this list without ever staying on
			it for long.</p>
	{% else %}
		<p class="small stale">Nobody is being kept off this bss.</p>
	{% endif %}
</div>

{% if own|length %}
<div class="card">
	<p class="small"><b>What this bss decides for itself</b> — {{ own|length }} option{{ own|length > 1 ? 's' : '' }}
		written over the network's:</p>
	<table class="counters small">
		<tr><th>option</th><th>this bss</th></tr>
		{% for name, value in own %}
			<tr><td class="mono">{{ name }}</td>
				<td><b>{{ value is iterable ? value|join(', ') : value }}</b></td></tr>
		{% endfor %}
	</table>
</div>
{% endif %}

{% if running_config %}
<div class="card">
	{% set watch = {
		'ocv': 'ties the handshake to the channel it happens on',
		'beacon_prot': 'signs beacons; ap.uc defaults it to 1 where pmf applies',
		'rnr': 'advertises the other bands of this access point',
		'wnm_sleep_mode': 'lets a station sleep and be told what it missed',
		'wnm_sleep_mode_no_keys': 'workaround for clients that lose keys on waking',
		'ieee80211w': 'protected management frames; 2 is required',
		'wpa': 'the rsn version',
		'wpa_key_mgmt': 'which handshakes are offered',
		'wpa_pairwise': 'the cipher',
		'sae_require_mfp': 'sae without pmf is not sae',
		'sae_pwe': 'with radius keys only on a wpad-saeradh2e access point',
		'wpa_psk_radius': '2 means the key comes from the access-accept',
		'macaddr_acl': 'how the filter list is read',
		'bss_load_update_period': 'how often the load element is refreshed',
		'chan_util_avg_period': 'the window that load is averaged over',
		'mbo': 'multiband operation',
		'proxy_arp': 'answers arp for sleeping stations',
		'multicast_to_unicast': 'turns multicast into unicast per station',
		'bss_transition': '802.11v transitions offered',
		'ieee80211k': 'neighbour reports offered',
		'ignore_broadcast_ssid': 'hidden network',
		'max_num_sta': 'a ceiling on stations',
		'no_probe_resp_if_max_sta': 'stop answering probes at the ceiling'
	} %}
	<h3 class="small" style="margin:0 0 .3em">What these options became on the device</h3>
	<table class="counters small">
		<tr><th>option</th><th>running</th><th></th></tr>
		{% for name, why in watch %}
			{% if running_config[name] is defined %}
				<tr>
					<td class="mono">{{ name }}</td>
					<td><b>{{ running_config[name] }}</b></td>
					<td class="stale">{{ why }}</td>
				</tr>
			{% endif %}
		{% endfor %}
	</table>
	<p class="small"><b>Everything else</b> — {{ running_config|length }} lines in the
		running hostapd configuration for this bss, as the consistency check last read it.
		An option set above and missing here did not arrive.</p>
	<details class="group">
		<summary>show the {{ running_config|length }} lines</summary>
		<table class="opts">
			{% for name, value in running_config %}
				<tr><td class="name mono">{{ name }}</td><td class="val">{{ value }}</td></tr>
			{% endfor %}
		</table>
	</details>
</div>
{% endif %}

{% if hints %}
<div class="card warn-card">
	<p class="small"><b>Worth knowing about what is set here</b></p>
	<ul class="small">{% for h in hints %}<li>{{ h }}</li>{% endfor %}</ul>
</div>
{% endif %}

{% if probes or ctrlcounts %}
<div class="card">
	{% if probes %}
		<h3 class="small" style="margin:0 0 .3em">What this bss hears</h3>
		<p class="small stale">
			{{ probes.stations }} stations, one entry each at its <b>strongest</b> — a threshold above
			that is a station turned away for good rather than now and then. Strongest
			{{ probes.max }}, median {{ probes.median }}, weakest {{ probes.min }} dBm.
			From the probe requests of the last week.
		</p>
		<table class="hist small">
			{% for edge, n in probes.bins|reverse(true) %}
				<tr>
					<th>{{ edge }}…{{ edge + 4 }}</th>
					<td class="bar"><span style="width: {{ probes.peak ? (n * 100 / probes.peak)|round : 0 }}%">&nbsp;</span></td>
					<td class="n">{{ n ?: '' }}</td>
				</tr>
			{% endfor %}
		</table>
		<table class="thresh small">
			<tr><th>threshold</th>{% for t, r in probes.thresholds %}<th>{{ t }}</th>{% endfor %}</tr>
			<tr><th>would keep</th>{% for t, r in probes.thresholds %}<td>{{ r.kept }}</td>{% endfor %}</tr>
			<tr><th>would turn away</th>{% for t, r in probes.thresholds %}
				<td class="{{ r.turned_away ? 'warn' : '' }}">{{ r.turned_away }}</td>{% endfor %}</tr>
		</table>
	{% endif %}
	{% if ctrlcounts %}
		<h3 class="small" style="margin:1em 0 .3em">What hostapd has reported about it</h3>
		<table class="counters small">
			<tr><th>event</th><th>count</th><th>per hour</th><th>avg</th><th>worst</th><th>last</th></tr>
			{% for name, c in ctrlcounts %}
				<tr>
					<td class="mono">{{ name }}</td>
					<td>{{ c.n }}</td>
					<td>{{ c.rate is not null ? c.rate : '—' }}</td>
					<td>{{ c.ms_avg is not null ? c.ms_avg|round(2) ~ ' ms' : '—' }}</td>
					<td>{{ c.ms_max ? c.ms_max|round(2) ~ ' ms' : '—' }}</td>
					<td>{{ c.last ? (c.last|date('Y-m-d H:i')) : '—' }}</td>
				</tr>
			{% endfor %}
		</table>
	{% endif %}
</div>
{% endif %}

{% if events %}
<div class="card">
	<h3 class="small" style="margin:0 0 .3em">The last things hostapd said about it</h3>
	<table class="counters small">
		<tr><th>when</th><th>event</th><th>station</th><th>detail</th></tr>
		{% for e in events %}
			<tr>
				<td class="stale">{{ e.ts ? (e.ts|date('H:i:s')) : '—' }}</td>
				<td class="mono">{{ e.event }}</td>
				<td class="mono">{{ e.address ?: '' }}</td>
				<td class="stale">{{ e.fields is defined and e.fields ? e.fields|json_encode : (e.raw|default('')) }}</td>
			</tr>
		{% endfor %}
	</table>
</div>
{% endif %}

<form id="editor" method="post" action="{{ path('device_save', {'id': device.id}) }}">
	<div class="toolbar sticky">
		<input type="search" id="filter" placeholder="filter by name or description…">
		<label class="small">show
			<select id="scope">
				<option value="documented">set and documented defaults</option>
				<option value="all">everything, including inactive functions</option>
				<option value="set">only what is set</option>
			</select>
		</label>
		<button type="button" id="toggleall" class="ghost small">close all</button>
		<span id="shown" class="small stale"></span>
		<span class="spacer"></span>
		<button type="submit">Save</button>
		<span id="result" class="small"></span>
	</div>

	<p class="small legend">
		<span class="tag set">set</span> stored and written to the access point ·
		<span class="tag def">default</span> not stored, the shown OpenWrt default applies ·
		<span class="tag off">off</span> a switch that is not written, so the function is off ·
		<span class="tag un">not written</span> hostapd's own built-in value applies
	</p>
	<p class="small legend">
		The values shown are what this bss would be given — the network's, with this bss's own
		written over them and the features applied. Saving stores only what differs from the
		network, so a later change to the network still reaches this bss. Clearing a field puts
		the option back to whatever the network says.
	</p>

	{{ include('default/_option_groups.html.twig') }}
</form>
{% endblock %}

{% block javascripts %}
{{ include('default/_option_filter.html.twig', {'storage_key': 'apman.device.scope'}) }}
<script>
// The endpoint hands over counters, not rates, and the arithmetic happens here
// — a status cycle that arrived late would otherwise draw as a spike, which is
// the graph lying about the network to cover for the collector.
(function () {
	var url = {{ path('device_series', {'id': device.id})|json_encode|raw }};
	var W = 300, H = 46;
	// Mirrored around the middle, the same as the client list and the client
	// page: up is to the stations, down is from them. One visual language for
	// one measurement.
	var MID = H / 2;
	function path(points, key, max, dir) {
		if (points.length < 2 || !max) { return ''; }
		var n = points.length, d = 'M0 ' + MID;
		for (var i = 0; i < n; i++) {
			d += ' L' + (i * W / (n - 1)).toFixed(1) + ' '
				+ (MID + dir * (points[i][key] / max) * (MID - 1)).toFixed(1);
		}
		return d + ' L' + W + ' ' + MID + ' Z';
	}
	function human(bps) {
		if (bps >= 1000000) { return (bps / 1000000).toFixed(1) + ' Mbit/s'; }
		if (bps >= 1000) { return Math.round(bps / 1000) + ' kbit/s'; }
		return bps + ' bit/s';
	}
	function draw() {
		fetch(url).then(function (r) { return r.json(); }).then(function (d) {
			var label = document.getElementById('sp-label');
			var pts = d.points || [];
			if (!pts.length) {
				label.innerHTML = 'nothing measured yet — a line needs two status cycles'
					+ (d.samples ? ' (' + d.samples + ' so far)' : '');
				return;
			}
			var max = 0;
			pts.forEach(function (p) { max = Math.max(max, p.rx, p.tx); });
			document.getElementById('sp-rx').setAttribute('d', path(pts, 'rx', max, 1));
			document.getElementById('sp-tx').setAttribute('d', path(pts, 'tx', max, -1));
			var last = pts[pts.length - 1];
			var span = pts.length > 1 ? (last.ts - pts[0].ts) : 0;
			label.innerHTML =
				'<span style="color: var(--bar-good)">▲</span> to the stations ' + human(last.tx)
				+ ' · <span style="color: var(--bar-plain)">▼</span> from them ' + human(last.rx)
				+ ' · peak ' + human(max)
				+ ' · ' + pts.length + ' points over ' + Math.round(span / 60) + ' min';
		}).catch(function () {});
	}
	draw();
	window.setInterval(draw, 10000);
})();
</script>
{% endblock %}

{% block stylesheets %}
{{ include('default/_option_styles.html.twig') }}
<style>
.stats { display: flex; flex-wrap: wrap; gap: 1.2em 2em; }
.stat { min-width: 8em; max-width: 24em; }
.stat b { display: block; font-size: 1.5em; line-height: 1.1; }
.stat span { display: block; font-size: .8em; }
.stat span + span { color: var(--ink-mute); }
table.counters { border-collapse: collapse; margin-top: .4em; }
table.counters th, table.counters td { padding: .25em .8em .25em 0; text-align: left; vertical-align: top; }
table.counters th { border-bottom: 1px solid var(--line-strong); font-weight: 600; }
table.thresh { border-collapse: collapse; margin: .3em 0 .5em; }
table.thresh th, table.thresh td { padding: .2em .9em .2em 0; text-align: left; }
table.thresh td.warn { color: var(--warn-strong); font-weight: 600; }
.spark { margin-top: .6em; max-width: 34em; }
.spark svg { width: 100%; height: 46px; display: block; background: var(--bg-sunken);
             border-radius: var(--r-sm); }
.spark p { margin: .25em 0 0; }
table.counters td.live { font-variant-numeric: tabular-nums; }
table.hist { border-collapse: collapse; margin: .5em 0; }
table.hist th { text-align: right; padding: .05em .6em .05em 0; font-weight: 400; white-space: nowrap; }
table.hist td.bar { width: 18em; height: auto; background: none; border-radius: 0; display: table-cell; }
table.hist td.bar span { display: block; background: var(--bar-plain); height: .9em; min-width: 0; }
table.hist td.n { padding-left: .6em; }
</style>
{% endblock %}
