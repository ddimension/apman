{% extends 'frontend.html.twig' %}
{% block header %}{% endblock %}

{% block body %}
<div class="gridbar">
	<label>Refresh
		<select id="refreshsel">
			<option value="5000">5s</option>
			<option value="15000">15s</option>
			<option value="60000">60s</option>
		</select>
	</label>
	<button id="pausebtn" type="button"></button>
	<button id="nowbtn" type="button">Refresh now</button>
	<span id="lastload" class="small"></span>
	<span class="spacer"></span>
	<label class="small"><input type="checkbox" id="onlyproblems"> only problems</label>
	<span id="summary" class="small"></span>
</div>

{# The search box matches text anywhere. These narrow by the things you
   actually ask about — which access point, which network, which band, how the
   station authenticated, and whether it uses a key of its own. The options are
   built from the data that is there, so an empty network never appears. #}
<div class="gridbar filters">
	<label class="small">AP <select id="f-ap"><option value="">all</option></select></label>
	<label class="small">Network <select id="f-ssid"><option value="">all</option></select></label>
	<label class="small">Band <select id="f-band"><option value="">all</option></select></label>
	<label class="small">Security <select id="f-akm"><option value="">all</option></select></label>
	<label class="small">Key
		<select id="f-identity">
			<option value="">all</option>
			<option value="own">own key</option>
			<option value="shared">network passphrase</option>
		</select>
	</label>
	<button id="f-reset" type="button" class="small">Reset</button>
	<span id="f-count" class="small stale"></span>
</div>
<div id="wrapper"></div>
<div id="clients"></div>

<script>
// ---- refresh control -------------------------------------------------------
let timeout = parseInt(localStorage.getItem('apman.refresh') || '15000');
let paused = localStorage.getItem('apman.paused') === '1';
let lastLoad = null;
let refreshHandle = null;

function updateGrid() {
	if (!paused) { loadData(); }
	clearTimeout(refreshHandle);
	refreshHandle = setTimeout(() => { updateGrid(); }, timeout);
}
function renderAge() {
	const el = document.getElementById('lastload');
	if (!el) return;
	if (paused) { el.textContent = 'paused'; return; }
	if (!lastLoad) { el.textContent = 'loading...'; return; }
	el.textContent = 'updated ' + Math.round((Date.now() - lastLoad) / 1000) + 's ago';
}
setInterval(renderAge, 1000);

// ---- rendering helpers -----------------------------------------------------
const esc = (s) => String(s === null || s === undefined ? '' : s)
	.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

function signalBar(dbm, noise) {
	if (dbm === null || dbm === undefined || dbm === '') return '<span class="muted">–</span>';
	const pct = Math.max(0, Math.min(100, Math.round((dbm + 100) * 100 / 60)));
	const cls = dbm < -75 ? 'bad' : (dbm < -65 ? 'weak' : 'good');
	const snr = (noise !== null && noise !== undefined && noise !== '') ? ' · SNR ' + (dbm - noise) + ' dB' : '';
	return '<span class="metric" title="' + esc(dbm + ' dBm' + (noise ? ', noise ' + noise + ' dBm' : '') + snr) + '">' +
		'<span class="bar ' + cls + '"><span style="width:' + pct + '%"></span></span>' +
		'<span class="num">' + dbm + '</span></span>';
}

// griddata already delivers Mbit/s (parsed out of the station dump), so no
// conversion here; the bar is against a fixed ceiling to keep rows comparable
function rateCell(rx, tx) {
	const fmt = (v) => (v === null || v === undefined || v === '') ? null : Math.round(parseFloat(v));
	const r = fmt(rx), t = fmt(tx);
    if (r === null && t === null) return '<span class="muted">–</span>';
	const worst = Math.min(r === null ? 9999 : r, t === null ? 9999 : t);
	const cls = worst < 25 ? 'bad' : (worst < 100 ? 'weak' : 'good');
	const pct = Math.max(4, Math.min(100, Math.round(Math.max(r || 0, t || 0) / 866 * 100)));
	return '<span class="metric" title="rx ' + (r ?? '?') + ' / tx ' + (t ?? '?') + ' Mbit/s">' +
		'<span class="bar ' + cls + '"><span style="width:' + pct + '%"></span></span>' +
		'<span class="num">' + (r ?? '?') + '/' + (t ?? '?') + '</span></span>';
}

function bytes(n) {
	if (n === null || n === undefined || n === '') return '–';
	if (n > 1073741824) return (n / 1073741824).toFixed(1) + ' G';
	if (n > 1048576) return (n / 1048576).toFixed(1) + ' M';
	if (n > 1024) return (n / 1024).toFixed(0) + ' K';
	return n + ' B';
}

function duration(sec) {
	if (sec === null || sec === undefined || sec === '') return '–';
	if (sec > 86400) return Math.floor(sec / 86400) + 'd ' + Math.floor((sec % 86400) / 3600) + 'h';
	if (sec > 3600) return Math.floor(sec / 3600) + 'h ' + Math.floor((sec % 3600) / 60) + 'm';
	if (sec > 60) return Math.floor(sec / 60) + 'm';
	return sec + 's';
}

function pill(text, cls) { return '<span class="tag ' + (cls || '') + '">' + esc(text) + '</span>'; }

// ---- sorting ---------------------------------------------------------------
// merged cells carry objects, so every column gets a comparator that pulls the
// value a human would sort by out of it
const num = (v) => {
	const n = parseFloat(v);

	return isNaN(n) ? Number.NEGATIVE_INFINITY : n;
};
const txt = (v) => String(v === null || v === undefined ? '' : v).toLowerCase();
const by = (fn) => ({ compare: (a, b) => {
	const x = fn(a), y = fn(b);
	if (typeof x === 'number' || typeof y === 'number') { return (x || 0) - (y || 0); }

	return String(x).localeCompare(String(y), undefined, { numeric: true });
} });
// band first, then channel, so 2.4 and 5 GHz do not interleave
const bandKey = (c) => num(c.band) * 1000 + num(c.channel);

// ---- columns ---------------------------------------------------------------
// identity, location and link quality are merged; everything that should stay
// sortable keeps its raw value as cell data and is only formatted here
const columns = [
	{
		id: 'client', name: 'Client', sort: by((c) => txt(c.dnsname || c.mac)),
		formatter: (c) => {
			const name = c.dnsname || '';
			const short = name.length > 22 ? name.slice(0, 21) + '…' : name;
			let html = '<a class="mac" href="{{ path('aps') }}/../client/' + encodeURIComponent(c.mac) + '">' + esc(c.mac) + '</a>';
			if (c.private === 'yes') html += pill('random', 'warn');
			html += '<div class="sub">';
			if (name) html += '<span title="' + esc(name) + '">' + esc(short) + '</span> ';
			if (c.ip) html += '<span class="muted">' + esc(c.ip) + '</span>';
			if (!name && !c.ip && c.vendor) html += '<span class="muted">' + esc(c.vendor) + '</span>';
			html += '</div>';
			if (name && c.vendor) html += '<div class="sub muted" title="' + esc(c.vendor) + '">' + esc(c.vendor.slice(0, 24)) + '</div>';
			return gridjs.html(html);
		}
	},
	{
		id: 'where', name: 'Where', sort: by((c) => txt(c.ap) + ' ' + txt(c.iface)),
		formatter: (c) => gridjs.html(
			'<a href="{{ path('aps') }}/../ap/' + encodeURIComponent(c.ap) + '">' + esc(c.ap) + '</a>' +
			'<div class="sub">' + esc(c.iface) + (c.vlan && c.vlan !== c.iface ? ' <span class="tag">' + esc(c.vlan) + '</span>' : '') + '</div>' +
			'<div class="sub muted">' + esc(c.ssid || '') + '</div>')
	},
	{
		id: 'radio', name: 'Radio', sort: by(bandKey),
		formatter: (c) => gridjs.html(
			'<span class="tag ' + (c.band === '5' || c.band === '6' ? 'band5' : 'band2') + '">' + esc(c.band) + ' GHz</span>' +
			'<div class="sub">ch ' + esc(c.channel || '?') + ' · ' + esc(c.htmode || '') + '</div>')
	},
	{ id: 'signal', name: 'Signal', sort: by(num), formatter: (cell, row) => gridjs.html(signalBar(cell, row.cells[9].data)) },
	{ id: 'rate', name: 'Rate Mbit', sort: by((c) => Math.min(num(c.rx), num(c.tx))), formatter: (c) => gridjs.html(rateCell(c.rx, c.tx)) },
	{
		id: 'traffic', name: 'Traffic', sort: by((c) => num(c.rx) + num(c.tx)),
		formatter: (c) => gridjs.html('<span class="muted">↓</span> ' + bytes(c.rx) + '<div class="sub"><span class="muted">↑</span> ' + bytes(c.tx) + '</div>')
	},
	{
		id: 'time', name: 'Time', sort: by((c) => num(c.connected)),
		formatter: (c) => gridjs.html(duration(c.connected) + '<div class="sub muted" title="idle">idle ' + duration(c.inactive) + '</div>')
	},
	{
		id: 'security', name: 'Security', sort: by((c) => txt(c.identity) + txt(c.akm) + txt(c.auth) + txt(c.user)),
		formatter: (c) => {
			let html = pill(c.auth || 'NONE', c.auth && c.auth !== 'NONE' ? 'ok' : 'warn');
			if (c.mfp === 'yes') html += pill('MFP', 'ok');
			// what the client actually negotiated, which can differ from what
			// the bss offers — only known once hostapd has been asked
			// the issued key a client came in with — the only handle on a
			// device whose address is randomised
			if (c.identity) {
				html += '<div class="sub ok" title="iPSK identity ' + esc(c.keyid || '') + '">' +
					esc(c.identity) + '</div>';
			}
			if (c.akm) {
				html += '<div class="sub" title="negotiated AKM' +
					(c.cipher ? ', cipher ' + esc(c.cipher) : '') + '">' + esc(c.akm) + '</div>';
			}
			if (c.user) html += '<div class="sub" title="' + esc(c.user) + '">' + esc(String(c.user).slice(0, 18)) + '</div>';
			return gridjs.html(html);
		}
	},
	{
		id: 'caps', name: 'Caps', sort: by((c) => txt(c.ht) + (c.mbo === 'yes' ? '1' : '0') + (c.wmm === 'yes' ? '1' : '0')),
		formatter: (c) => {
			let html = '';
			if (c.ht) html += pill(c.ht, 'ok');
			['wmm', 'mbo', 'wds', 'wps'].forEach((k) => { if (c[k] === 'yes') html += pill(k.toUpperCase()); });
			return gridjs.html(html || '<span class="muted">–</span>');
		}
	},
	{ id: 'noise', name: 'Noise', hidden: true },
	// merged cells hold objects, which the search would stringify to
	// "[object Object]"; this hidden column keeps every row findable by mac,
	// name, ip, ap, interface, ssid or vendor
	{ id: 'haystack', name: 'search', hidden: true },
	{
		id: 'age', name: 'Age', sort: by(num),
		formatter: (cell) => {
			if (cell === null || cell === undefined) return gridjs.html('<span class="muted">?</span>');
			const cls = cell > 60 ? 'stale' : '';
			return gridjs.html('<span class="' + cls + '">' + cell + 's</span>');
		}
	},
	{
		name: 'Actions', sort: false,
		formatter: (cell, row) => {
			// identity lives in the first cell, location in the second
			const id = row.cells[0].data;
			const loc = row.cells[1].data;
			const mk = (label, url, cls) => gridjs.h('button', {
				className: 'act ' + (cls || ''),
				onClick: () => window.open(url)
			}, label);
			const q = 'system=' + encodeURIComponent(loc.ap) + '&device=' + encodeURIComponent(loc.iface) +
				'&mac=' + encodeURIComponent(id.mac) + '&ssid=' + encodeURIComponent(loc.ssid || '');
			return [
				mk('Steer', '{{ path('apman_default_wnmbsstransitionprepare') }}?' + q),
				mk('Kick', '{{ path('apman_default_disconnect') }}?' + q, 'danger'),
				mk('Details', '{{ path('aps') }}/../client/' + encodeURIComponent(id.mac))
			];
		}
	}
];

// ---- data loading ----------------------------------------------------------
// The grid used to run in server mode, so every refresh tore the table down and
// only then waited for the request: loading overlay, lost scroll position and a
// reset of search and sorting. Now the fetch happens in the background and the
// table is only updated once the data is there.
function mapRows(results) {
	return results.map((c) => [
			{ mac: c.mac, dnsname: c.dnsname, ip: c.ip, vendor: c.manufacturer, private: c.mac_private },
				{ ap: c.ap, iface: c.interface, vlan: c.vlan_device, ssid: c.ssid },
				{ band: c.frequency > 5900 ? '6' : (c.frequency > 3000 ? '5' : '2.4'), channel: c.channel, htmode: c.ht_mode },
				c.signal,
				{ rx: c.rx_rate, tx: c.tx_rate },
				{ rx: c.rx_bytes, tx: c.tx_bytes },
				{ connected: c.connected_time, inactive: c.inactive },
				{ auth: c.authtype, mfp: c.mfp, user: c.authuser, akm: c.akm, cipher: c.cipher,
				  identity: c.identity, keyid: c.keyid },
				{ ht: c.ht_mode, wmm: c.wmm, mbo: c.mbo, wds: c.wds, wps: c.wps },
				c.noise,
				[c.mac, c.dnsname, c.ip, c.ap, c.interface, c.ssid, c.manufacturer, c.vlan_device]
					.filter(Boolean).join(' '),
		c.age,
		'',
	]);
}

let loading = false;
let pendingRows = null;

async function loadData(force) {
	if (loading) { return; }
	loading = true;
	document.getElementById('lastload').classList.add('loading');
	try {
		const res = await fetch('{{ path('apman_default_griddata') }}', { headers: { 'Accept': 'application/json' } });
		const data = await res.json();
		window.apmanRows = data.results;
		refreshFilterOptions(data.results);
		const shown = visibleClients();
		updateSummary(shown);
		document.getElementById('f-count').textContent =
			shown.length === data.results.length ? '' : shown.length + ' of ' + data.results.length;
		const rows = mapRows(shown);
		lastLoad = new Date();
		// do not yank the table away while the user is typing in the search box
		// or has a text selection open; keep the rows and apply them later
		if (busy()) { pendingRows = rows; } else { applyRows(rows); }
	} catch (e) {
		document.getElementById('summary').innerHTML = '<span class="warn">refresh failed: ' + e + '</span>';
	}
	loading = false;
	document.getElementById('lastload').classList.remove('loading');
	renderAge();
}

function busy() {
	const el = document.activeElement;
	if (el && el.classList && el.classList.contains('gridjs-search-input')) { return true; }
	const sel = window.getSelection();

	return !!(sel && String(sel).length > 2);
}

// keep search term, sort state and scroll position across the update
function applyRows(rows) {
	const input = document.querySelector('.gridjs-search-input');
	const term = input ? input.value : '';
	const wrapper = document.querySelector('.gridjs-wrapper');
	const scroll = wrapper ? wrapper.scrollTop : 0;
	const y = window.scrollY;

	grid.updateConfig({ data: rows }).forceRender();

	requestAnimationFrame(() => {
		const el = document.querySelector('.gridjs-search-input');
		if (el && term) {
			el.value = term;
			el.dispatchEvent(new Event('input', { bubbles: true }));
		}
		const w = document.querySelector('.gridjs-wrapper');
		if (w) { w.scrollTop = scroll; }
		window.scrollTo(0, y);
	});
}

grid = new gridjs.Grid({
	search: true,
	resizable: true,
	sort: true,
	columns: columns,
	data: [],
	
	style: { table: { 'font-size': '13px' }, td: { padding: '3px 6px' } }
});

// a row is worth looking at when the link is weak, the rate collapsed or the
// state stale
function isProblem(c) {
	return (c.signal !== null && c.signal < -72)
		|| (c.tx_rate !== null && c.tx_rate < 25000)
		|| (c.age !== null && c.age > 60);
}
function onlyProblems() { return document.getElementById('onlyproblems').checked; }

// ---- filters ---------------------------------------------------------------
// One place decides which raw clients are shown; everything that refreshes the
// table goes through it, so a filter survives the five second reload the same
// way the search term and the scroll position do.
const FILTERS = {
	ap:       { el: 'f-ap',       value: (c) => c.ap || '' },
	ssid:     { el: 'f-ssid',     value: (c) => c.ssid || '' },
	band:     { el: 'f-band',     value: (c) => bandOf(c) },
	akm:      { el: 'f-akm',      value: (c) => c.akm || '' },
};

function bandOf(c) {
	if (!c.frequency) { return ''; }

	return c.frequency > 5900 ? '6 GHz' : (c.frequency > 3000 ? '5 GHz' : '2.4 GHz');
}

// a station has a key of its own when the answer carried an identity
function usesOwnKey(c) { return !!(c.identity || c.keyid); }

function filterState() {
	const state = {};
	for (const [key, f] of Object.entries(FILTERS)) {
		state[key] = document.getElementById(f.el).value;
	}
	state.identity = document.getElementById('f-identity').value;

	return state;
}

function passesFilters(c) {
	const state = filterState();
	for (const [key, f] of Object.entries(FILTERS)) {
		if (state[key] && f.value(c) !== state[key]) { return false; }
	}
	if ('own' === state.identity && !usesOwnKey(c)) { return false; }
	if ('shared' === state.identity && usesOwnKey(c)) { return false; }

	return true;
}

function visibleClients() {
	const all = window.apmanRows || [];

	return all.filter((c) => passesFilters(c) && (!onlyProblems() || isProblem(c)));
}

// rebuild the option lists from the data, keeping what is already chosen even
// when it momentarily has no clients — otherwise a filter would clear itself
// the second the last station roams away
function refreshFilterOptions(all) {
	for (const [, f] of Object.entries(FILTERS)) {
		const el = document.getElementById(f.el);
		const chosen = el.value;
		const values = [...new Set(all.map(f.value).filter(Boolean))].sort();
		if (chosen && !values.includes(chosen)) { values.push(chosen); values.sort(); }
		el.innerHTML = '<option value="">all</option>'
			+ values.map((v) => '<option value="' + v + '"' + (v === chosen ? ' selected' : '') + '>' + v + '</option>').join('');
	}
}

function applyFilters() {
	const shown = visibleClients();
	const all = window.apmanRows || [];
	document.getElementById('f-count').textContent =
		shown.length === all.length ? '' : shown.length + ' of ' + all.length;
	applyRows(mapRows(shown));
	updateSummary(shown);
}

function updateSummary(rows) {
	const n = rows.length;
	const weak = rows.filter((c) => c.signal !== null && c.signal < -72).length;
	const slow = rows.filter((c) => c.tx_rate !== null && c.tx_rate < 25000).length;
	const bands = {};
	rows.forEach((c) => { const b = c.frequency > 5900 ? '6' : (c.frequency > 3000 ? '5' : '2.4'); bands[b] = (bands[b] || 0) + 1; });
	document.getElementById('summary').innerHTML =
		n + ' clients · ' + Object.entries(bands).map(([b, v]) => v + '×' + b + 'G').join(' · ') +
		(weak ? ' · <span class="warn">' + weak + ' weak</span>' : '') +
		(slow ? ' · <span class="warn">' + slow + ' slow</span>' : '');
}

grid.render(document.getElementById("clients"));
loadData();

function setPauseLabel() { document.getElementById('pausebtn').textContent = paused ? 'Resume' : 'Pause'; }
document.getElementById('refreshsel').value = String(timeout);
document.getElementById('refreshsel').addEventListener('change', (e) => {
	timeout = parseInt(e.target.value);
	localStorage.setItem('apman.refresh', String(timeout));
	updateGrid();
});
document.getElementById('pausebtn').addEventListener('click', () => {
	paused = !paused;
	localStorage.setItem('apman.paused', paused ? '1' : '0');
	setPauseLabel(); renderAge();
	if (!paused) { updateGrid(); }
});
document.getElementById('nowbtn').addEventListener('click', () => { loadData(true); });
document.getElementById('onlyproblems').addEventListener('change', applyFilters);
for (const id of ['f-ap', 'f-ssid', 'f-band', 'f-akm', 'f-identity']) {
	document.getElementById(id).addEventListener('change', () => {
		localStorage.setItem('apman.filter.' + id, document.getElementById(id).value);
		applyFilters();
	});
	// a filter you set should still be set after a reload
	const saved = localStorage.getItem('apman.filter.' + id);
	if (saved) {
		const el = document.getElementById(id);
		if (![...el.options].some((o) => o.value === saved)) {
			el.insertAdjacentHTML('beforeend', '<option value="' + saved + '">' + saved + '</option>');
		}
		el.value = saved;
	}
}
document.getElementById('f-reset').addEventListener('click', () => {
	for (const id of ['f-ap', 'f-ssid', 'f-band', 'f-akm', 'f-identity']) {
		document.getElementById(id).value = '';
		localStorage.removeItem('apman.filter.' + id);
	}
	document.getElementById('onlyproblems').checked = false;
	applyFilters();
});
// apply an update that was held back while the user was busy
document.addEventListener('click', () => {
	if (pendingRows && !busy()) { applyRows(pendingRows); pendingRows = null; }
});
setPauseLabel(); renderAge();
refreshHandle = setTimeout(() => { updateGrid(); }, timeout);
</script>
{% endblock %}

{% block stylesheets %}
<style>
	.gridbar { display: flex; gap: .75rem; align-items: center; margin-bottom: .5rem; flex-wrap: wrap; }
	.gridbar .spacer { flex: 1; }
	/* the filter row sits under the toolbar and is quieter than it */
	.gridbar.filters { gap: .6rem; padding: .3rem .1rem; border-top: 1px solid #eee;
	                   border-bottom: 1px solid #eee; margin-bottom: .6rem; }
	.gridbar.filters select { max-width: 14rem; }
	.gridbar button, .gridbar select { padding: .2rem .5rem; }
	.sub { font-size: 85%; line-height: 1.25; }
	.muted { color: #99a; }
	.stale { color: #b90; font-style: italic; }
	a.mac { font-family: ui-monospace, monospace; }
	.tag { display: inline-block; padding: 0 .35em; margin-right: .2em; border-radius: 3px;
	       background: #eef; color: #335; font-size: 84%; }
	.tag.ok { background: #dfd; color: #060; }
	.tag.warn { background: #fdd; color: #900; }
	.tag.band5 { background: #e5eeff; color: #24457a; }
	.tag.band2 { background: #fff0e0; color: #7a4a24; }
	.metric { display: flex; align-items: center; gap: .35rem; white-space: nowrap; }
	.metric .num { font-variant-numeric: tabular-nums; }
	.bar { display: inline-block; height: .55rem; width: 46px; background: #e6e6ea;
	       border-radius: 2px; overflow: hidden; }
	.bar > span { display: block; height: 100%; background: #4a8; }
	.bar.good > span { background: #4a8; }
	.bar.weak > span { background: #d90; }
	.bar.bad > span { background: #c33; }
	button.act { font-size: 85%; padding: 1px 6px; margin-right: 2px; }
	button.act.danger { color: #900; }
	.gridjs-td { vertical-align: top; }
</style>
{% endblock %}

{% block javascripts %}{% endblock %}
