###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# For an SQLite database, use: "sqlite:///%kernel.project_dir%/var/data.db"
# For a PostgreSQL database, use: "postgresql://db_user:db_password@127.0.0.1:5432/db_name?serverVersion=11&charset=utf8"
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
# and it has to be the truth. The server here is MariaDB; claiming "5.7" makes
# Doctrine pick the MySQL platform, where JSON is a type of its own while
# MariaDB reports it as longtext. Every schema comparison then shows thirteen
# ALTER statements that can never be satisfied. With the real version they are
# all gone.
DATABASE_URL=mysql://db_user:db_password@127.0.0.1:3306/db_name?serverVersion=mariadb-10.11.6
###< doctrine/doctrine-bundle ###

#FIREWALL_URL=http://192.168.1.1/ubus
#FIREWALL_USER=root
#FIREWALL_PASSWORD=XXXXXXXX

MEMCACHE=memcached://127.0.0.1:11211
MQTT_HOST=
MQTT_USERNAME=
MQTT_PASSWORD=

REDIS=localhost

###> apman radius server ###
# The controller's own RADIUS server, answering hostapd's MAC-ACL questions
# with the per device keys. Off unless a shared secret is configured, because
# a server without one would answer anybody who can reach the port.
# Diagnostics only: answer every request with this key, without asking the
# database. Leave empty in operation.
###< apman radius server ###
